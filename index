                    e.preventDefault();
                } else if (serverSearchFocus || e.code === "Backspace" || (e.key && e.key.length === 1)) {
                    serverSearchFocus = true;
                    if (e.code === "Backspace") {
                        serverSearch = serverSearch.slice(0, -1);
                        selectedServerIndex = -1;
                        serverScroll = 0;
                        e.preventDefault();
                    } else if (e.key && e.key.length === 1 && !e.ctrlKey && !e.metaKey && serverSearch.length < 32) {
                        serverSearch += e.key;
                        selectedServerIndex = -1;
                        serverScroll = 0;
                        e.preventDefault();
