                        };
                        players.push(p);
                    }
                    // Hedef pozisyon — her kare lerp ile yumuşatılır (kasılma azalır)
                    p._tx = sp.x; p._ty = sp.y;
                    p.vx = sp.vx; p.vy = sp.vy;
                    // İlk paket veya büyük sapma: anında yapıştır
                    if (p._tx == null || Math.abs((p.x || 0) - sp.x) > 80 || Math.abs((p.y || 0) - sp.y) > 80) {
                        p.x = sp.x; p.y = sp.y;
                    }
                    // Kendi karakterinde hafif tahmin: input ile zaten yürüyoruz, sunucu ile yumuşak hizala
                    if (p.id === myPlayerId) {
                        p._tx = sp.x; p._ty = sp.y;
                    }
                    p.hp = sp.hp; p.maxHp = sp.maxHp; p.isDead = sp.isDead;
                    p.score = sp.score; p.shieldTime = sp.shieldTime;
                    p.onGround = sp.onGround; p.width = sp.width; p.height = sp.height;
                    p.sizeMult = sp.sizeMult || 1;
                    p.skinId = sp.skinId || "default";
