                ctx.font = "bold 15px 'Impact'";
                ctx.textAlign = "center";
                ctx.fillText(`P${tab.id}`, tab.x + tab.w / 2, tab.y + 21);
            });

            // Altın
            ctx.fillStyle = "#ffcc00";
            ctx.font = "bold 16px monospace";
            ctx.textAlign = "left";
            ctx.fillText(`Altın: ${playerGold[selectedStorePlayer]}`, 450, 75);

            // === SOL LİSTE ===
            ctx.fillStyle = "#12141c";
            ctx.fillRect(STORE_LIST_X, STORE_LIST_Y, STORE_LIST_W, STORE_LIST_H);
            ctx.strokeStyle = "#333";
            ctx.lineWidth = 2;
            ctx.strokeRect(STORE_LIST_X, STORE_LIST_Y, STORE_LIST_W, STORE_LIST_H);

            // Scroll bar
            if (shopItems.length > STORE_VISIBLE) {
                const barH = (STORE_VISIBLE / shopItems.length) * STORE_LIST_H;
                const barY = STORE_LIST_Y + (storeScroll / (shopItems.length - STORE_VISIBLE)) * (STORE_LIST_H - barH);
                ctx.fillStyle = "#ff0055";
                ctx.fillRect(STORE_LIST_X + STORE_LIST_W - 6, barY, 5, barH);
            }

            for (let i = 0; i < STORE_VISIBLE; i++) {
                const idx = storeScroll + i;
                if (idx >= shopItems.length) break;
                const item = shopItems[idx];
                const y = STORE_LIST_Y + i * STORE_ITEM_H;
                const isSelected = (idx === selectedStoreItem);
                const isOwned = ownedSkins[selectedStorePlayer].includes(item.id);
                const isEquipped = equippedSkins[selectedStorePlayer] === item.id;

                ctx.fillStyle = isSelected ? "#1a2a3a" : (i % 2 === 0 ? "#15171f" : "#12141c");
                ctx.fillRect(STORE_LIST_X + 1, y, STORE_LIST_W - 8, STORE_ITEM_H - 1);

                if (isEquipped) {
                    ctx.fillStyle = "#33ff66";
                    ctx.fillRect(STORE_LIST_X + 1, y, 4, STORE_ITEM_H - 1);
                }

                // Mini renk
                ctx.fillStyle = item.head || "#ff3366";
                ctx.fillRect(STORE_LIST_X + 12, y + 10, 10, 10);
                ctx.fillStyle = item.body || "#ff3366";
                ctx.fillRect(STORE_LIST_X + 10, y + 20, 14, 14);

                ctx.fillStyle = "#fff";
                ctx.font = "bold 14px 'Impact'";
                ctx.textAlign = "left";
                ctx.fillText(item.name, STORE_LIST_X + 32, y + 18);

                ctx.fillStyle = "#aaa";
                ctx.font = "11px monospace";
                ctx.fillText(item.power, STORE_LIST_X + 32, y + 34);

                ctx.textAlign = "right";
                if (isEquipped) {
                    ctx.fillStyle = "#33ff66";
                    ctx.fillText("KUŞANILI", STORE_LIST_X + STORE_LIST_W - 14, y + 26);
                } else if (isOwned) {
                    ctx.fillStyle = "#33ccff";
                    ctx.fillText("SAHİP", STORE_LIST_X + STORE_LIST_W - 14, y + 26);
                } else {
                    ctx.fillStyle = "#ffcc00";
                    ctx.fillText(`${item.price}`, STORE_LIST_X + STORE_LIST_W - 14, y + 26);
                }
            }

            // === SAĞ DETAY PANELİ ===
            const detailX = 370;
            const detailY = 100;
            const detailW = 400;
            const detailH = 280;

            ctx.fillStyle = "#131520";
            ctx.fillRect(detailX, detailY, detailW, detailH);
            ctx.strokeStyle = "#444";
            ctx.lineWidth = 2;
            ctx.strokeRect(detailX, detailY, detailW, detailH);

            const item = shopItems[selectedStoreItem];
            if (item) {
                // Büyük önizleme
                ctx.fillStyle = item.head || "#ff3366";
                ctx.fillRect(detailX + 30, detailY + 30, 28, 28);
                ctx.fillStyle = item.body || "#ff3366";
                ctx.fillRect(detailX + 26, detailY + 58, 36, 36);

                ctx.fillStyle = "#fff";
                ctx.font = "bold 22px 'Impact'";
                ctx.textAlign = "left";
                ctx.fillText(item.name, detailX + 80, detailY + 40);

                ctx.fillStyle = "#ff9900";
                ctx.font = "bold 15px 'Impact'";
                ctx.fillText("Güç: " + item.power, detailX + 80, detailY + 65);

                // Açıklama (wrap)
                ctx.fillStyle = "#ccc";
                ctx.font = "13px monospace";
                const words = item.desc.split(" ");
                let line = "";
                let ly = detailY + 100;
                for (let w of words) {
                    const test = line + w + " ";
                    if (ctx.measureText(test).width > detailW - 40) {
                        ctx.fillText(line, detailX + 20, ly);
                        line = w + " ";
                        ly += 18;
                    } else {
                        line = test;
                    }
                }
                ctx.fillText(line, detailX + 20, ly);

                // İstatistikler
                ly += 30;
                ctx.fillStyle = "#88aacc";
                ctx.font = "12px monospace";
                ctx.fillText(`Can: ${item.maxHp}   Hız: x${item.speedMult}   Zıplama: x${item.jumpMult}`, detailX + 20, ly);
                ly += 18;
                ctx.fillText(`Skor: x${item.scoreMult}   Kalkan: x${item.shieldMult}   Boyut: x${item.sizeMult}`, detailX + 20, ly);
            }

            // Satın Al / Kuşan butonu
            const owned = ownedSkins[selectedStorePlayer].includes(item.id);
            const equipped = equippedSkins[selectedStorePlayer] === item.id;
            let btnText = "";
            let btnColor = "#555";

            if (equipped) {
                btnText = "KUŞANILDI";
                btnColor = "#1b3322";
            } else if (owned) {
                btnText = "KUŞAN";
                btnColor = "#2288cc";
            } else if (playerGold[selectedStorePlayer] >= item.price) {
                btnText = `SATIN AL (${item.price} Altın)`;
                btnColor = "#cc8800";
            } else {
                btnText = "YETERSİZ ALTIN";
                btnColor = "#552222";
            }

            ctx.fillStyle = btnColor;
            ctx.fillRect(menuButtons.storeBuy.x, menuButtons.storeBuy.y, menuButtons.storeBuy.w, menuButtons.storeBuy.h);
            ctx.fillStyle = "#fff";
            ctx.font = "bold 18px 'Impact'";
            ctx.textAlign = "center";
            ctx.fillText(btnText, menuButtons.storeBuy.x + menuButtons.storeBuy.w / 2, menuButtons.storeBuy.y + 27);

            // Ana menü butonu
            ctx.fillStyle = "#ff0055";
            ctx.fillRect(menuButtons.storeExit.x, menuButtons.storeExit.y, menuButtons.storeExit.w, menuButtons.storeExit.h);
            ctx.fillStyle = "#fff";
            ctx.font = "bold 16px 'Impact'";
            ctx.fillText("ANA MENÜ", menuButtons.storeExit.x + menuButtons.storeExit.w / 2, menuButtons.storeExit.y + 25);

            // Kaydırma ipucu
            ctx.fillStyle = "#555875";
            ctx.font = "11px monospace";
            ctx.textAlign = "left";
            ctx.fillText("Mouse tekerleği ile kaydır", STORE_LIST_X, STORE_LIST_Y + STORE_LIST_H + 16);
        }

        function update() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);

            if (gameState === "MAIN_MENU") {
                ctx.fillStyle = "#0d0e15";
                ctx.fillRect(0, 0, canvas.width, canvas.height);
                if (!mobilePerf && settings.quality !== "low") {
                    ctx.strokeStyle = "rgba(255, 0, 85, 0.08)";
                    ctx.lineWidth = 2;
                    for (let i = 0; i < canvas.width; i += 40) { ctx.beginPath(); ctx.moveTo(i, 0); ctx.lineTo(i, canvas.height); ctx.stroke(); }
                    for (let j = 0; j < canvas.height; j += 40) { ctx.beginPath(); ctx.moveTo(0, j); ctx.lineTo(canvas.width, j); ctx.stroke(); }
                }
                ctx.fillStyle = "#ff0055";
                ctx.font = "bold 65px 'Impact'";
                ctx.textAlign = "center";
                ctx.shadowColor = "#ff0055";
                ctx.shadowBlur = 15;
                ctx.fillText("Lava Rain", canvas.width / 2, 130);
                ctx.shadowBlur = 0;
                ctx.fillStyle = "#ff0055";
                ctx.fillRect(menuButtons.normalMode.x, menuButtons.normalMode.y, menuButtons.normalMode.w, menuButtons.normalMode.h);
                ctx.fillStyle = "#ffffff";
                ctx.font = "bold 17px 'Impact'";
                ctx.fillText(t("normal"), canvas.width / 2, menuButtons.normalMode.y + 26);
                ctx.fillStyle = "#9933ff";
                ctx.fillRect(menuButtons.duelMode.x, menuButtons.duelMode.y, menuButtons.duelMode.w, menuButtons.duelMode.h);
                ctx.fillStyle = "#ffffff";
                ctx.fillText(t("duel"), canvas.width / 2, menuButtons.duelMode.y + 26);
                ctx.fillStyle = "#ff9900";
                ctx.fillRect(menuButtons.storeMode.x, menuButtons.storeMode.y, menuButtons.storeMode.w, menuButtons.storeMode.h);
                ctx.fillStyle = "#000000";
                ctx.fillText(t("store"), canvas.width / 2, menuButtons.storeMode.y + 26);
                ctx.fillStyle = "#00ccaa";
                ctx.fillRect(menuButtons.serversMode.x, menuButtons.serversMode.y, menuButtons.serversMode.w, menuButtons.serversMode.h);
                ctx.fillStyle = "#000000";
                ctx.fillText(t("servers"), canvas.width / 2, menuButtons.serversMode.y + 26);
                ctx.fillStyle = "#6688aa";
                ctx.fillRect(menuButtons.settingsMode.x, menuButtons.settingsMode.y, menuButtons.settingsMode.w, menuButtons.settingsMode.h);
                ctx.fillStyle = "#ffffff";
                ctx.fillText(t("settings"), canvas.width / 2, menuButtons.settingsMode.y + 26);
            }
            else if (gameState === "SETTINGS") {
                drawSettings();
            }
            else if (gameState === "PLAYER_SELECT") {
                ctx.fillStyle = "#0d0e15";
                ctx.fillRect(0, 0, canvas.width, canvas.height);
                ctx.fillStyle = "#ffffff";
                ctx.font = "bold 40px 'Impact'";
                ctx.textAlign = "center";
                ctx.fillText("KAC KISI OYNAYACAK?", canvas.width / 2, 180);
                menuButtons.players.forEach(btn => {
                    ctx.fillStyle = "#33ccff";
                    ctx.fillRect(btn.x, btn.y, btn.w, btn.h);
                    ctx.fillStyle = "#000000";
                    ctx.font = "bold 26px 'Impact'";
                    ctx.fillText(`${btn.count}P`, btn.x + btn.w / 2, btn.y + btn.h / 2 + 9);
                });
                // Geri butonu
                const back = menuButtons.playerSelectBack;
                ctx.fillStyle = "#555";
                ctx.fillRect(back.x, back.y, back.w, back.h);
                ctx.fillStyle = "#fff";
                ctx.font = "bold 15px 'Impact'";
                ctx.textAlign = "center";
                ctx.fillText("GERİ", back.x + back.w / 2, back.y + 25);
            }
            else if (gameState === "STORE") {
                drawStore();
            }
            else if (gameState === "SERVERS") {
                drawServers();
            }
            else if (gameState === "CREATE_SERVER") {
                drawCreateServer();
            }
            else if (gameState === "ONLINE_LOBBY") {
                // Client input gönder
                if (isOnline && !isHost && !chatOpen && !pauseMenuOpen && !hostPaused) {
                    const nowI = Date.now();
                    const payload = JSON.stringify({ left: ctrlLeft(), right: ctrlRight(), jump: ctrlJump(), shoot: ctrlShoot() });
                    const inputGap = mobilePerf ? 50 : 40;
                    if (payload !== lastInputPayload || nowI - lastInputSend > inputGap) {
                        lastInputPayload = payload;
                        lastInputSend = nowI;
                        const o = JSON.parse(payload);
                        netSend({ type: "input", left: o.left, right: o.right, jump: o.jump, shoot: o.shoot });
                    }
                }
                if (isHost && !pauseMenuOpen && !hostPaused) updateLobbyPhysics();
                drawOnlineLobby();
                updateMobileControlsVisibility();
                if (hostPaused) drawHostPausedOverlay();
                if (pauseMenuOpen) drawPauseMenu();
            }
            else if (gameState === "JOIN_CODE") {
                drawJoinCode();
            }
            else if (gameState === "PLAYING" || gameState === "GAMEOVER") {

                if (gameState === "PLAYING" && (!isOnline || isHost) && !pauseMenuOpen && !hostPaused) {
                    // Gun Mayhem arena — lav yok, sabit platformlar
                    lavaPhase = isDuelMode ? "DUEL_ARENA" : "ARENA";
                    lockShrinkage = true;
                    climbModeActive = false;
                    lavaLevel = 9999;
                    // Zone capture tick
                    if (activeGameMode === "zone" && zones.length) {
                        zones.forEach(z => {
                            let occupants = [];
                            players.forEach(p => {
                                if (p.isDead) return;
                                if (p.x + p.width > z.x && p.x < z.x + z.w && p.y + p.height > z.y && p.y < z.y + z.h) {
                                    occupants.push(p.id);
                                }
                            });
                            if (occupants.length === 1) {
                                const id = occupants[0];
                                if (z.owner === id) z.progress = Math.min(100, z.progress + 0.4);
                                else {
                                    z.progress = Math.max(0, z.progress - 0.6);
                                    if (z.progress <= 0) { z.owner = id; z.progress = 1; }
                                }
                                if (z.owner === id && z.progress >= 100) {
                                    const p = players.find(x => x.id === id);
                                    if (p && !p.isDead) p.score += 1;
                                }
                            }
                        });
                    }
                }

                // Platformlar (Gun Mayhem)
                if (!platforms.length) platforms = buildArenaPlatforms(activeMapId || "classic");
                platforms.forEach(pl => {
                    ctx.fillStyle = "#1a1c28";
                    ctx.fillRect(pl.x, pl.y, pl.w, pl.h);
                    ctx.fillStyle = "#ff0055";
                    ctx.fillRect(pl.x, pl.y, pl.w, 4);
                    ctx.fillStyle = "#333";
                    ctx.fillRect(pl.x, pl.y + pl.h - 2, pl.w, 2);
                });
                // Zone
                zones.forEach(z => {
                    ctx.fillStyle = z.owner ? (PLAYER_COLORS[(z.owner - 1) % PLAYER_COLORS.length] + "44") : "rgba(0,200,170,0.15)";
                    ctx.fillRect(z.x, z.y, z.w, z.h);
                    ctx.strokeStyle = "#00ccaa";
                    ctx.lineWidth = 2;
                    ctx.strokeRect(z.x, z.y, z.w, z.h);
                    ctx.fillStyle = "#fff";
                    ctx.font = "11px monospace";
                    ctx.textAlign = "center";
                    ctx.fillText("ZONE " + Math.floor(z.progress) + "%", z.x + z.w / 2, z.y + z.h / 2);
                });
                // Flags
                flags.forEach(f => {
                    if (f.carriedBy) return;
                    ctx.fillStyle = f.team === 1 ? "#ff3366" : "#33ccff";
                    ctx.fillRect(f.x, f.y - 24, 10, 28);
                    ctx.fillRect(f.x + 10, f.y - 24, 16, 12);
                });

                // Kalkanlar
                for (let i = shields.length - 1; i >= 0; i--) {
                    let s = shields[i];
                    if ((!isOnline || isHost) && !hostPaused) s.y += s.speed;
                    ctx.fillStyle = "#33ff66";
                    ctx.fillRect(s.x, s.y, s.size, s.size);
                    ctx.fillStyle = "#fff";
                    ctx.fillRect(s.x + 4, s.y + 4, s.size - 8, s.size - 8);
                    players.forEach(p => {
                        if (!hostPaused && !p.isDead && checkCollision(p, { x: s.x, y: s.y, width: s.size, height: s.size })) {
                            p.shieldTime = Math.round(300 * (p.shieldMult || 1));
                            shields.splice(i, 1);
                        }
                    });
                    if (s.y > canvas.height) shields.splice(i, 1);
                }

                // Silah sandıkları (Gun Mayhem)
                for (let i = weapons.length - 1; i >= 0; i--) {
                    let w = weapons[i];
                    if ((!isOnline || isHost) && !hostPaused) w.y += w.speed;
                    const wcol = w.color || "#9933ff";
                    ctx.fillStyle = wcol;
                    ctx.fillRect(w.x, w.y, w.size, w.size);
                    ctx.fillStyle = "#111";
                    ctx.fillRect(w.x + 4, w.y + 6, w.size - 8, w.size - 12);
                    ctx.fillStyle = "#fff";
                    ctx.font = "9px monospace";
                    ctx.textAlign = "center";
                    const wn = (WEAPON_TYPES[w.weaponId] || {}).name || "GUN";
                    ctx.fillText(wn.slice(0, 6), w.x + w.size / 2, w.y - 4);
                    players.forEach(p => {
                        if (!hostPaused && !p.isDead && checkCollision(p, { x: w.x, y: w.y, width: w.size, height: w.size })) {
                            const wid = w.weaponId || "smg";
                            const def = WEAPON_TYPES[wid] || WEAPON_TYPES.smg;
                            p.weaponId = wid;
                            p.ammo = def.ammo === Infinity ? Infinity : def.ammo;
                            p.fireCooldown = 5;
                            weapons.splice(i, 1);
                        }
                    });
                    if (w.y > canvas.height) weapons.splice(i, 1);
                }

                // Mermiler
                for (let i = bullets.length - 1; i >= 0; i--) {
                    let b = bullets[i];
                    if ((!isOnline || isHost) && !hostPaused) {
                        b.x += b.vx;
                        b.y += (b.vy || 0);
                    }
                    ctx.fillStyle = b.color || "#ff00ff";
                    ctx.fillRect(b.x, b.y, b.width, b.height);
                    let hit = false;
                    players.forEach(p => {
                        if (hit || hostPaused || p.isDead || p.id === b.ownerId) return;
                        if (checkCollision(b, p)) {
                            const owner = players.find(o => o.id === b.ownerId);
                            const dmg = b.damage || 1;
                            for (let d = 0; d < dmg; d++) pDamage(p, owner);
                            const knock = b.knock != null ? b.knock : 8;
                            p.vx += (b.vx > 0 ? 1 : -1) * knock * 0.45;
                            p.vy -= 2;
                            if (b.explosive) {
                                players.forEach(o2 => {
                                    if (o2.isDead || o2.id === b.ownerId) return;
                                    const dx = (o2.x + o2.width / 2) - (b.x + b.width / 2);
                                    const dy = (o2.y + o2.height / 2) - (b.y + b.height / 2);
                                    if (Math.sqrt(dx * dx + dy * dy) < 70 && o2.id !== p.id) {
                                        pDamage(o2, owner);
                                        o2.vx += dx > 0 ? 4 : -4;
                                    }
                                });
                            }
                            hit = true;
                            bullets.splice(i, 1);
                        }
                    });
                    if (!hit && (b.x < -40 || b.x > canvas.width + 40 || b.y < -40 || b.y > canvas.height + 40)) bullets.splice(i, 1);
                }

                // Hazardlar
                for (let i = hazards.length - 1; i >= 0; i--) {
                    let h = hazards[i];
                    if ((!isOnline || isHost) && !hostPaused) h.y += h.speed;
                    ctx.fillStyle = "#ff3300";
                    ctx.fillRect(h.x, h.y, h.size, h.size);
                    ctx.strokeStyle = "#ffffff";
                    ctx.lineWidth = 2;
                    ctx.strokeRect(h.x, h.y, h.size, h.size);
                    players.forEach(p => {
                        if (!hostPaused && !p.isDead && checkCollision(p, { x: h.x, y: h.y, width: h.size, height: h.size })) {
                            pDamage(p);
                            hazards.splice(i, 1);
                        }
                    });
                    if (h.y > canvas.height) hazards.splice(i, 1);
                }

                // Oyuncu güncelleme
                let aliveCount = 0;

                // Online client: input gönder + yumuşak interpolasyon
                if (isOnline && !isHost) {
                    if (!chatOpen && !pauseMenuOpen && !hostPaused) {
                        const nowI = Date.now();
                        const payload = JSON.stringify({ left: ctrlLeft(), right: ctrlRight(), jump: ctrlJump(), shoot: ctrlShoot() });
                        const inputGap = mobilePerf ? 45 : 33;
                        if (payload !== lastInputPayload || nowI - lastInputSend > inputGap) {
                            lastInputPayload = payload;
                            lastInputSend = nowI;
                            const o = JSON.parse(payload);
                            netSend({ type: "input", left: o.left, right: o.right, jump: o.jump, shoot: o.shoot });
                        }
                    }
                    smoothNetworkPlayers();
                    players.forEach(p => { if (!p.isDead) aliveCount++; });
                    updateMobileControlsVisibility();
                } else if (!hostPaused && (!pauseMenuOpen || isOnline)) {
                players.forEach(p => {
                    if (p.isDead) return;
                    aliveCount++;
                    if (p.shieldTime > 0) p.shieldTime--;
                    if (p.pushAnim && p.pushAnim > 0) p.pushAnim--;
                    if (p.fireCooldown > 0) p.fireCooldown--;

                    const spd = 4.2 * (p.speedMult || 1);
                    let goLeft = false, goRight = false, doJump = false, doShoot = false;

                    if (isOnline && isHost) {
                        if (p.id === myPlayerId) {
                            if (!chatOpen) {
                                goLeft = ctrlLeft();
                                goRight = ctrlRight();
                                doJump = ctrlJump();
                                doShoot = ctrlShoot();
                            }
                        } else {
                            const ri = remoteInputs[p.id] || {};
                            goLeft = !!ri.left; goRight = !!ri.right; doJump = !!ri.jump; doShoot = !!ri.shoot;
                        }
                    } else {
                        // Offline: tuşlar + mobil
                        if (activePlayerCount === 1 || (isTouchDevice() && p.id === 1)) {
                            goLeft = !!(p.leftKey && keys[p.leftKey]) || touchControls.left;
                            goRight = !!(p.rightKey && keys[p.rightKey]) || touchControls.right;
                            doJump = !!(p.jumpKey && keys[p.jumpKey]) || touchControls.jump;
                            doShoot = !!(p.shootKey && keys[p.shootKey]) || touchControls.shoot;
                        } else {
                            goLeft = !!(p.leftKey && keys[p.leftKey]);
                            goRight = !!(p.rightKey && keys[p.rightKey]);
                            doJump = !!(p.jumpKey && keys[p.jumpKey]);
                            doShoot = !!(p.shootKey && keys[p.shootKey]);
                        }
                    }

                    if (goLeft) { p.vx = -spd; p.facing = -1; }
                    else if (goRight) { p.vx = spd; p.facing = 1; }
                    else p.vx *= 0.78;

                    if (doJump && p.onGround) {
                        p.vy = -9 * (p.jumpMult || 1);
                        p.onGround = false;
                    }
                    if (doShoot) tryShoot(p);

                    p.vy += gravity * (p.gravityMult || 1);
                    p.x += p.vx;
                    p.y += p.vy;

                    if (p.x < 0) p.x = 0;
                    if (p.x + p.width > canvas.width) p.x = canvas.width - p.width;

                    let stoodOnPlatform = false;
                    const plats = platforms.length ? platforms : [platform];
                    plats.forEach(pl => {
                        const px = pl.x != null ? pl.x : pl.x;
                        const py = pl.y != null ? pl.y : pl.y;
                        const pw = pl.w != null ? pl.w : pl.width;
                        const ph = pl.h != null ? pl.h : pl.height;
                        if (p.x + p.width > px && p.x < px + pw) {
                            if (p.y + p.height >= py && p.y + p.height - p.vy <= py + 14 && p.vy >= 0) {
                                p.y = py - p.height;
                                p.vy = 0;
                                p.onGround = true;
                                stoodOnPlatform = true;
                            }
                        }
                    });
                    if (!stoodOnPlatform) p.onGround = false;
                    // CTF flag pickup / score
                    if (activeGameMode === "ctf" && flags.length) {
                        flags.forEach(f => {
                            if (f.carriedBy === p.id) {
                                f.x = p.x + p.width / 2;
                                f.y = p.y;
                                // score if near own base
                                const home = flags.find(x => x.team !== f.team);
                                // scoring: carry enemy flag to own home
                                const ownHome = flags.find(x => x.team === ((p.id % 2) + 1));
                                // simplify: team 1 = odd ids, team 2 = even
                                const myTeam = (p.id % 2 === 1) ? 1 : 2;
                                if (f.team !== myTeam) {
                                    const hx = f.team === 1 ? 700 : 80; // enemy flag home opposite - use own home coords
                                    const ownFlag = flags.find(x => x.team === myTeam);
                                    if (ownFlag && Math.abs(p.x - ownFlag.homeX) < 40 && Math.abs(p.y - ownFlag.homeY) < 50) {
                                        p.score += 50;
                                        f.carriedBy = null;
                                        f.x = f.homeX; f.y = f.homeY;
                                    }
                                }
                            } else if (!f.carriedBy) {
                                if (checkCollision(p, { x: f.x, y: f.y - 24, width: 26, height: 28 })) {
                                    const myTeam = (p.id % 2 === 1) ? 1 : 2;
                                    if (f.team !== myTeam) f.carriedBy = p.id;
                                }
                            }
                        });
                    }

                    if (p.y > canvas.height) {
                        if (!isTestMode) {
                            p.hp = 0;
                            p.isDead = true;
                            const card = document.getElementById(`p${p.id}-card`);
                            if (card) card.classList.add("dead");
                        } else {
                            p.y = 100;
                            p.vy = 0;
                        }
                    }
                });
                } // end host/local physics

                // Oyuncu-oyuncu çarpışma — sadece host/local
                if ((!isOnline || isHost) && !hostPaused)
                for (let i = 0; i < players.length; i++) {
                    for (let j = i + 1; j < players.length; j++) {
                        let p1 = players[i], p2 = players[j];
                        if (!p1.isDead && !p2.isDead && checkCollision(p1, p2)) {
                            // Kütleyi boyuta göre abart (gerçekçi his için)
                            const m1 = Math.pow(p1.sizeMult || 1, 2.5);
                            const m2 = Math.pow(p2.sizeMult || 1, 2.5);
                            const totalMass = m1 + m2;

                            let midX1 = p1.x + p1.width / 2;
                            let midX2 = p2.x + p2.width / 2;
                            let overlapX = Math.min(p1.x + p1.width, p2.x + p2.width) - Math.max(p1.x, p2.x);

                            // Ağır olan neredeyse yerinde kalır, hafif olan uçar
                            const push1 = overlapX * (m2 / totalMass);
                            const push2 = overlapX * (m1 / totalMass);

                            if (midX1 < midX2) {
                                p1.x -= push1;
                                p2.x += push2;
                            } else {
                                p1.x += push1;
                                p2.x -= push2;
                            }

                            // Momentum tabanlı hız transferi
                            const v1 = p1.vx;
                            const v2 = p2.vx;

                            // Klasik 1D elastik çarpışma
                            let newV1 = (v1 * (m1 - m2) + 2 * m2 * v2) / totalMass;
                            let newV2 = (v2 * (m2 - m1) + 2 * m1 * v1) / totalMass;

                            // Çok hafif olan ağır olanı itemez (filtre)
                            // Eğer birinin kütlesi diğerinin 2 katından fazlaysa,
                            // hafif olanın verdiği itme neredeyse sıfırlanır
                            if (m1 > m2 * 2) {
                                // p1 çok daha ağır → p2 uçar, p1 az etkilenir
                                newV1 = v1 * 0.92 + newV1 * 0.08; // neredeyse hızını korur
                                newV2 = newV2 * 1.15;             // hafif olan daha fazla savrulur
                            } else if (m2 > m1 * 2) {
                                // p2 çok daha ağır
                                newV2 = v2 * 0.92 + newV2 * 0.08;
                                newV1 = newV1 * 1.15;
                            }

                            p1.vx = newV1;
                            p2.vx = newV2;

                            // Aşırı hızı biraz sınırla
                            p1.vx = Math.max(-12, Math.min(12, p1.vx));
                            p2.vx = Math.max(-12, Math.min(12, p2.vx));

                            // İtme animasyonu tetikle (daha ağır olan veya hızı olan iter)
                            const dir = midX1 < midX2 ? 1 : -1; // p1'in p2'ye göre yönü
                            if (m1 >= m2) {
                                // p1 itiyor
                                p1.pushAnim = 18;
                                p1.pushDir = dir;
                            }
                            if (m2 >= m1) {
                                // p2 itiyor
                                p2.pushAnim = 18;
                                p2.pushDir = -dir;
                            }
                            // Eşitse ikisi de animasyon yapsın
                            if (Math.abs(m1 - m2) < 0.15) {
                                p1.pushAnim = 18;
                                p1.pushDir = dir;
                                p2.pushAnim = 18;
                                p2.pushDir = -dir;
                            }
                        }
                    }
                }

                players.forEach(p => {
                    if (!p.isDead) {
                        drawPlayer(p);
                        const lowQ = mobilePerf || settings.quality === "low";
                        if (!lowQ || p.id === myPlayerId || !isOnline) {
                            const wdef = WEAPON_TYPES[p.weaponId] || WEAPON_TYPES.pistol;
                            ctx.fillStyle = wdef.color || "#aaa";
                            ctx.font = "bold 10px monospace";
                            ctx.textAlign = "center";
                            const ammoTxt = (wdef.ammo === Infinity || p.ammo == null) ? "∞" : String(p.ammo);
                            ctx.fillText(wdef.name + " " + ammoTxt, p.x + p.width / 2, p.y - 16);
                        }
                        const wdef2 = WEAPON_TYPES[p.weaponId] || WEAPON_TYPES.pistol;
                        const gx = p.facing >= 0 ? p.x + p.width - 2 : p.x - 14;
                        ctx.fillStyle = wdef2.color || "#ccc";
                        ctx.fillRect(gx, p.y + 16, 14, 5);
                    }
                });

                

                let gameOverCondition = (activePlayerCount === 1 && aliveCount === 0) || (activePlayerCount > 1 && aliveCount <= 1);
                if (gameOverCondition && gameState === "PLAYING" && !isTestMode && (!isOnline || isHost)) {
                    gameState = "GAMEOVER";
                    determineWinner();
                    if (isOnline && isHost) {
                        netSend({
                            type: "gameover",
                            winnerText, winnerColor,
                            players: players.map(p => ({ id: p.id, score: p.score, isDead: p.isDead, hp: p.hp }))
                        });
                        // altın sadece host tarafında local eklenir (determineWinner)
                    }
                }
                if (isOnline && isHost && gameState === "PLAYING") broadcastState();
                if (isOnline && isHost && gameState === "GAMEOVER") broadcastState();

                ctx.font = "bold 18px 'Impact'";
                ctx.textAlign = "center";
                const modeLabel = (GAME_MODES.find(m => m.id === activeGameMode) || {}).nameKey;
                const modeName = modeLabel ? t(modeLabel) : activeGameMode;
                if (isDuelMode) {
                    ctx.fillStyle = "#ffcc00";
                    ctx.fillText("DÜELLO — SİLAH TOPLA, ATEŞ ET!", canvas.width / 2, 36);
                } else {
                    ctx.fillStyle = "#00ccaa";
                    ctx.fillText("ARENA | " + modeName + " | Silah topla, it, hayatta kal", canvas.width / 2, 36);
                }

                if (gameState === "GAMEOVER") {
                    ctx.fillStyle = "rgba(0, 0, 0, 0.85)";
                    ctx.fillRect(0, 0, canvas.width, canvas.height);
                    ctx.fillStyle = winnerColor;
                    ctx.font = "bold 40px 'Impact'";
                    ctx.textAlign = "center";
                    ctx.fillText(winnerText, canvas.width / 2, canvas.height / 2 - 30);
                    ctx.fillStyle = "#ffffff";
                    ctx.font = "18px monospace";
                    if (isOnline) {
                        if (isHost) {
                            ctx.fillText("Sağ Shift = Yeniden başlat  |  Enter = Chat", canvas.width / 2, canvas.height / 2 + 20);
                            ctx.fillText("ESC = Ayarlar menüsü", canvas.width / 2, canvas.height / 2 + 48);
                        } else {
                            ctx.fillText("Host yeniden başlatana kadar bekleyin...", canvas.width / 2, canvas.height / 2 + 20);
                            ctx.fillText("Enter = Chat  |  ESC = Menü", canvas.width / 2, canvas.height / 2 + 48);
                        }
                    } else {
                        ctx.fillText("Tekrar oynamak icin 'ENTER'  |  ESC = Menü", canvas.width / 2, canvas.height / 2 + 30);
                    }
                }
                updateMobileControlsVisibility();
                if (showTabPlayers) drawTabPlayerList();
                if (hostPaused) drawHostPausedOverlay();
                if (pauseMenuOpen) drawPauseMenu();
            } else {
                updateMobileControlsVisibility();
            }
            // FPS
            fpsFrames++;
            const nowF = Date.now();
            if (nowF - fpsLast >= 1000) {
                fpsValue = fpsFrames;
                fpsFrames = 0;
                fpsLast = nowF;
            }
            if (settings.showFps) {
                ctx.fillStyle = "rgba(0,0,0,0.5)";
                ctx.fillRect(canvas.width - 70, 4, 64, 18);
                ctx.fillStyle = "#0f0";
                ctx.font = "12px monospace";
                ctx.textAlign = "right";
                ctx.fillText(fpsValue + " FPS", canvas.width - 8, 17);
            }
            requestAnimationFrame(update);
        }

        // Chat input events
        (function setupChat() {
            const inp = document.getElementById("chat-input");
            if (!inp) return;
            inp.addEventListener("keydown", (e) => {
                e.stopPropagation();
                if (e.code === "Enter" || e.key === "Enter") {
                    e.preventDefault();
                    closeChat(true);
                } else if (e.code === "Escape" || e.key === "Escape") {
                    e.preventDefault();
                    closeChat(false);
                }
            });
            inp.addEventListener("keyup", (e) => e.stopPropagation());
            // Mobil: focus kaybında kapatma yok; kullanıcı göndersin
            inp.addEventListener("touchstart", (e) => {
                e.stopPropagation();
                try { inp.focus(); } catch (err) {}
            }, { passive: true });
        })();

        // Mobil metin paneli olayları
        (function setupMobileText() {
            const inp = document.getElementById("mobile-text-input");
            const ok = document.getElementById("mobile-text-ok");
            const cancel = document.getElementById("mobile-text-cancel");
            const wrap = document.getElementById("mobile-text-wrap");
            if (!inp || !ok || !cancel || !wrap) return;

            inp.addEventListener("input", () => {
                syncMobileFieldValue(inp.value);
            });
            inp.addEventListener("keydown", (e) => {
                e.stopPropagation();
                if (e.key === "Enter" || e.code === "Enter") {
                    e.preventDefault();
                    closeMobileText(true);
                } else if (e.key === "Escape" || e.code === "Escape") {
                    e.preventDefault();
                    closeMobileText(false);
                }
            });
            inp.addEventListener("keyup", (e) => e.stopPropagation());
            ok.addEventListener("click", (e) => {
                e.preventDefault();
                e.stopPropagation();
                closeMobileText(true);
            });
            cancel.addEventListener("click", (e) => {
                e.preventDefault();
                e.stopPropagation();
                closeMobileText(false);
            });
            // Panel içi dokunuşlar canvas'a gitmesin
            wrap.addEventListener("touchstart", (e) => e.stopPropagation(), { passive: true });
            wrap.addEventListener("mousedown", (e) => e.stopPropagation());
        })();

        setupMobileControls();
        ensureDiscoveryConnection();
        tryStartMusic();
        requestAnimationFrame(update);
    </script>
</body>
