            p1: { left: "KeyA", right: "KeyD", jump: "KeyW", shoot: "KeyF" },
            p2: { left: "ArrowLeft", right: "ArrowRight", jump: "ArrowUp", shoot: "Period" },
            p3: { left: "KeyJ", right: "KeyL", jump: "KeyI", shoot: "KeyH" },
            p4: { left: "Numpad4", right: "Numpad6", jump: "Numpad8", shoot: "Numpad0" }
        };
        const DEFAULT_ONLINE_CONTROLS = {
            left: "KeyA", right: "KeyD", jump: "KeyW", shoot: "KeyF", shootAlt: "KeyL"
        };
        let offlineControls = JSON.parse(JSON.stringify(DEFAULT_OFFLINE_CONTROLS));
        let onlineControls = JSON.parse(JSON.stringify(DEFAULT_ONLINE_CONTROLS));
        let controlRemap = null; // { scope: "offline"|"online", player?: "p1", action: "left" }
        let settingsTab = "ses"; // ses | kontrol | kalite | dil
        let controlSubTab = "offline"; // offline | online
        let volumeDragging = false;

        function loadSettings() {
            try {
                const raw = localStorage.getItem("lavaRainSettings");
                if (raw) settings = Object.assign(settings, JSON.parse(raw));
            } catch (e) {}
            try {
                const oc = localStorage.getItem("lavaRainOfflineControls");
                if (oc) offlineControls = Object.assign(JSON.parse(JSON.stringify(DEFAULT_OFFLINE_CONTROLS)), JSON.parse(oc));
            } catch (e) {}
            try {
                const onc = localStorage.getItem("lavaRainOnlineControls");
                if (onc) onlineControls = Object.assign(JSON.parse(JSON.stringify(DEFAULT_ONLINE_CONTROLS)), JSON.parse(onc));
            } catch (e) {}
            applySettings();
        }
        function saveSettings() {
            try { localStorage.setItem("lavaRainSettings", JSON.stringify(settings)); } catch (e) {}
            try { localStorage.setItem("lavaRainOfflineControls", JSON.stringify(offlineControls)); } catch (e) {}
            try { localStorage.setItem("lavaRainOnlineControls", JSON.stringify(onlineControls)); } catch (e) {}
            applySettings();
        }
        function keyLabel(code) {
            if (!code) return "—";
            const map = {
                ArrowLeft: "←", ArrowRight: "→", ArrowUp: "↑", ArrowDown: "↓",
                Space: "SPACE", Period: ".", Comma: ",",
                Numpad0: "Num0", Numpad4: "Num4", Numpad6: "Num6", Numpad8: "Num8",
                ShiftLeft: "L-Shift", ShiftRight: "R-Shift", ControlLeft: "L-Ctrl", ControlRight: "R-Ctrl"
            };
            if (map[code]) return map[code];
            if (code.startsWith("Key")) return code.slice(3);
            if (code.startsWith("Digit")) return code.slice(5);
            return code;
        }
        function resetControls(scope) {
            if (scope === "offline") offlineControls = JSON.parse(JSON.stringify(DEFAULT_OFFLINE_CONTROLS));
            else onlineControls = JSON.parse(JSON.stringify(DEFAULT_ONLINE_CONTROLS));
            controlRemap = null;
            saveSettings();
        }
