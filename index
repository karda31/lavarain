            }
        }

        function smoothNetworkPlayers() {
            if (isHost || !isOnline || gameState !== "PLAYING") return;
            players.forEach(p => {
                if (p.isDead) return;
                if (p._tx == null || p._ty == null) return;
                // Lokal oyuncu: daha yumuşak düzeltme (tahmin + hizalama)
                const lerp = (p.id === myPlayerId) ? 0.28 : 0.42;
                p.x += (p._tx - p.x) * lerp;
                p.y += (p._ty - p.y) * lerp;
                // Küçük hız tahmini (paketler arası)
                if (p.id !== myPlayerId) {
                    p.x += (p.vx || 0) * 0.35;
                    p.y += (p.vy || 0) * 0.2;
                }
            });
        }

        function broadcastState() {
