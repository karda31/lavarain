                    destroyPeer();
                    gameState = "MAIN_MENU";
                    document.getElementById("scoreboard").style.visibility = "hidden";
                    tryStartMusic();
                }, 150);
                return;
            }
            if (isOnline && !isHost) {
                netSend({ type: "leave", playerId: myPlayerId, name: name, reason: reason || "leave" });
                addChat("Sistem", "Sunucudan ayrıldın.", "#ffaa66");
                setTimeout(() => {
                    destroyPeer();
                    gameState = "MAIN_MENU";
                    document.getElementById("scoreboard").style.visibility = "hidden";
                    tryStartMusic();
                }, 100);
                return;
            }
            destroyPeer();
            gameState = "MAIN_MENU";
            document.getElementById("scoreboard").style.visibility = "hidden";
            tryStartMusic();
        }

        function returnToOnlineLobby() {
            // Host herkesi lobiye döndürür (oda açık kalır)
            pauseMenuOpen = false;
            gameTimers.forEach(clearInterval);
            gameTimers = [];
            hazards = [];
            shields = [];
