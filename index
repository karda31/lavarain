            if (!e.changedTouches || !e.changedTouches.length) return;
            if (chatOpen || mobileTextCtx) return;
            const t = e.changedTouches[0];
            e.preventDefault();
            suppressNextClick = true;
            setTimeout(() => { suppressNextClick = false; }, 450);
            const fake = new MouseEvent("click", {
                clientX: t.clientX,
                clientY: t.clientY,
                bubbles: true,
                cancelable: true,
                view: window
