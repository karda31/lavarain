        function drawSpeechBubble(cx, topY, text, color) {
            if (!text) return;
            const now = Date.now();
            ctx.font = "bold 11px monospace";
            const padX = 6, padY = 4;
            const tw = Math.min(ctx.measureText(text).width, 120);
            const bw = tw + padX * 2;
            const bh = 18;
            const bx = cx - bw / 2;
            const by = topY - bh - 8;
            ctx.fillStyle = "rgba(0,0,0,0.75)";
            ctx.fillRect(bx, by, bw, bh);
            ctx.strokeStyle = color || "#00ccaa";
            ctx.lineWidth = 1;
            ctx.strokeRect(bx, by, bw, bh);
            // küçük üçgen
            ctx.fillStyle = "rgba(0,0,0,0.75)";
            ctx.beginPath();
            ctx.moveTo(cx - 4, by + bh);
            ctx.lineTo(cx + 4, by + bh);
            ctx.lineTo(cx, by + bh + 5);
            ctx.fill();
            ctx.fillStyle = "#fff";
            ctx.textAlign = "center";
            ctx.fillText(text.length > 28 ? text.slice(0, 26) + "…" : text, cx, by + 13);
        }

        function drawTabPlayerList() {
