        function drawPlayer(p) {
            if (p.isDead) return;
            let activeSkinId = equippedSkins[p.id] || "default";
            let skinConfig = shopItems.find(item => item.id === activeSkinId);
            let headColor = (skinConfig && skinConfig.head) ? skinConfig.head : p.color;
            let bodyColor = (skinConfig && skinConfig.body) ? skinConfig.body : p.color;

            const scale = p.sizeMult || 1;
            const barW = 30 * scale;
            const barH = 5;
            const barX = p.x + (p.width - barW) / 2;
            const barY = p.y - 12;

            ctx.fillStyle = "#1c1c24";
            ctx.fillRect(barX, barY, barW, barH);

            let cellW = (barW - 2) / p.maxHp;
            for (let i = 0; i < p.hp; i++) {
                ctx.fillStyle = p.color;
                ctx.fillRect(barX + 1 + (i * cellW), barY + 1, cellW - 0.5, barH - 2);
            }

            let isInvulnerable = p.shieldTime > 0 && Math.floor(Date.now() / 100) % 2 === 0;
            p.animFrame += Math.abs(p.vx) * 0.1;
            let legSwing = Math.sin(p.animFrame) * 4;

            // İtme animasyonu aktifse o yöne bak
            const isPushing = p.pushAnim && p.pushAnim > 0;
            let isFacingRight = isPushing ? (p.pushDir > 0) : (p.vx >= 0);

            ctx.fillStyle = isInvulnerable ? "#ffffff" : headColor;
            let headSize = 14 * scale;
            let headX = p.x + (p.width - headSize) / 2;
            let headY = p.y;
            ctx.fillRect(headX, headY, headSize, headSize);

            ctx.fillStyle = "#000000";
            let eyeX = isFacingRight ? headX + 7 * scale : headX + 2 * scale;
            ctx.fillRect(eyeX, headY + 4 * scale, 2 * scale, 3 * scale);
            ctx.fillRect(eyeX + 3 * scale, headY + 4 * scale, 2 * scale, 3 * scale);

            ctx.fillStyle = isInvulnerable ? "#ffffff" : bodyColor;
            let bodyW = 16 * scale;
            let bodyH = 18 * scale;
            let bodyX = p.x + (p.width - bodyW) / 2;
            let bodyY = p.y + headSize;
            ctx.fillRect(bodyX, bodyY, bodyW, bodyH);

            let armW = 4 * scale;
            let armH = 12 * scale;

            if (isPushing) {
                // İTME ANİMASYONU: bir kol öne doğru uzanır
                const progress = 1 - (p.pushAnim / 18); // 0 → 1
                const extend = (8 + progress * 10) * scale; // kol uzama mesafesi
                const armThickness = 5 * scale;

                if (isFacingRight) {
                    // Sol kol normal
                    ctx.fillRect(bodyX - armW + 2 * scale, bodyY + 2 * scale, armW, armH);
                    // Sağ kol öne uzanmış (itme)
                    ctx.fillRect(bodyX + bodyW - 2 * scale, bodyY + 4 * scale, extend, armThickness);
                    // El (küçük kare)
                    ctx.fillStyle = isInvulnerable ? "#ffffff" : headColor;
                    ctx.fillRect(bodyX + bodyW - 2 * scale + extend, bodyY + 2 * scale, 6 * scale, 8 * scale);
                } else {
                    // Sağ kol normal
                    ctx.fillRect(bodyX + bodyW - 2 * scale, bodyY + 2 * scale, armW, armH);
                    // Sol kol öne uzanmış (itme)
                    ctx.fillRect(bodyX + 2 * scale - extend, bodyY + 4 * scale, extend, armThickness);
                    // El
                    ctx.fillStyle = isInvulnerable ? "#ffffff" : headColor;
                    ctx.fillRect(bodyX + 2 * scale - extend - 6 * scale, bodyY + 2 * scale, 6 * scale, 8 * scale);
                }
            } else {
                // Normal yürüme kolları
                if (isFacingRight) {
                    ctx.fillRect(bodyX - armW + 2 * scale, bodyY + 2 * scale + Math.max(0, legSwing), armW, armH);
                    ctx.fillRect(bodyX + bodyW - 2 * scale, bodyY + 2 * scale - Math.min(0, legSwing), armW, armH);
                } else {
                    ctx.fillRect(bodyX - armW + 2 * scale, bodyY + 2 * scale - Math.min(0, legSwing), armW, armH);
                    ctx.fillRect(bodyX + bodyW - 2 * scale, bodyY + 2 * scale + Math.max(0, legSwing), armW, armH);
                }
            }

            // Bacaklar (itme sırasında da çiz)
            ctx.fillStyle = isInvulnerable ? "#ffffff" : bodyColor;
            let legW = 5 * scale;
            let legH = 12 * scale;
            let legY = bodyY + bodyH;

            if (!p.onGround) {
                ctx.fillRect(bodyX + 1 * scale, legY, legW, legH - 3 * scale);
                ctx.fillRect(bodyX + bodyW - 6 * scale, legY - 2 * scale, legW, legH - 3 * scale);
            } else {
                ctx.fillRect(bodyX + 1 * scale, legY + Math.max(0, legSwing), legW, legH - Math.max(0, legSwing));
                ctx.fillRect(bodyX + bodyW - 6 * scale, legY - Math.min(0, legSwing), legW, legH + Math.min(0, legSwing));
            }

            if (p.shieldTime > 0) {
                ctx.strokeStyle = "#00ffcc";
                ctx.lineWidth = 3;
                ctx.strokeRect(p.x - 6, p.y - 4, p.width + 12, p.height + 8);
            }
            // Sohbet baloncuğu
            const bub = speechBubbles[p.id];
            if (bub && bub.until > Date.now()) {
                drawSpeechBubble(p.x + p.width / 2, p.y - 14, bub.text, bub.color);
            } else if (bub) {
                delete speechBubbles[p.id];
            }
        }

        function determineWinner() {
            players.forEach(p => {
                playerGold[p.id] += p.score;
            });
            let alivePlayers = players.filter(p => !p.isDead);
            if (alivePlayers.length === 1) {
                let winner = alivePlayers[0];
                winnerText = `OYUNCU P${winner.id} KAZANDI! (+${winner.score} Altın)`;
                winnerColor = winner.color;
            } else {
                let sortedByScore = [...players].sort((a, b) => b.score - a.score);
                let highestScore = sortedByScore[0].score;
                if (highestScore > 0) {
                    let winners = players.filter(p => p.score === highestScore);
                    if (winners.length === 1) {
                        winnerText = `OYUNCU P${winners[0].id} KAZANDI! (+${winners[0].score} Altın)`;
                        winnerColor = winners[0].color;
                    } else {
                        winnerText = "BERABERE! ALTINLAR DAĞITILDI.";
                        winnerColor = "#ffffff";
                    }
                } else {
                    winnerText = "KAZANAN YOK!";
                    winnerColor = "#ff0055";
                }
            }
        }

        function pDamage(p, sourcePlayer = null) {
            if (p.shieldTime > 0) return;
            p.hp--;

            // Buz: hasar alınca kısa kalkan
            if (p.isIce && p.hp > 0) {
                p.shieldTime = Math.round(90 * (p.shieldMult || 1)); // ~1.5 sn
            }

            // Ateş: yakındaki rakiplere hasar yansıt
            if (p.isFire) {
                players.forEach(other => {
                    if (other.id !== p.id && !other.isDead) {
                        const dx = (other.x + other.width / 2) - (p.x + p.width / 2);
                        const dy = (other.y + other.height / 2) - (p.y + p.height / 2);
                        if (Math.sqrt(dx * dx + dy * dy) < 80) {
                            if (other.shieldTime <= 0) {
                                other.hp = Math.max(0, other.hp - 1);
                                if (other.hp <= 0 && !isTestMode) {
                                    other.isDead = true;
                                    document.getElementById(`p${other.id}-card`).classList.add("dead");
                                }
                            }
                        }
                    }
                });
            }

            // Vampir: hasar veren can çalsın
            if (sourcePlayer && sourcePlayer.isVampire && sourcePlayer.hp < sourcePlayer.maxHp) {
                if (Math.random() < 0.4) {
                    sourcePlayer.hp = Math.min(sourcePlayer.maxHp, sourcePlayer.hp + 1);
                }
            }

            if (p.hp <= 0) {
                p.hp = 0;
                if (!isTestMode) {
                    p.isDead = true;
                    document.getElementById(`p${p.id}-card`).classList.add("dead");
                } else {
                    p.hp = p.maxHp;
                }
            }
        }

