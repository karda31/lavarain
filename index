        function setupMobileControls() {
            mobileControlsEnabled = isTouchDevice();
            const root = document.getElementById("mobile-controls");
            if (!root || !mobileControlsEnabled) return;

            const bindHold = (id, key) => {
                const btn = document.getElementById(id);
                if (!btn) return;
                const down = (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    touchControls[key] = true;
                    btn.classList.add("pressed");
                };
                const up = (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    touchControls[key] = false;
                    btn.classList.remove("pressed");
                };
                btn.addEventListener("touchstart", down, { passive: false });
                btn.addEventListener("touchend", up, { passive: false });
                btn.addEventListener("touchcancel", up, { passive: false });
                btn.addEventListener("mousedown", down);
                btn.addEventListener("mouseup", up);
                btn.addEventListener("mouseleave", up);
            };
            bindHold("mc-left", "left");
            bindHold("mc-right", "right");
            bindHold("mc-jump", "jump");
            bindHold("mc-shoot", "shoot");

            const chatBtn = document.getElementById("mc-chat");
            if (chatBtn) {
                chatBtn.addEventListener("touchend", (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    if (isOnline && !chatOpen) openChat();
                }, { passive: false });
                chatBtn.addEventListener("click", (e) => {
                    e.preventDefault();
                    if (isOnline && !chatOpen) openChat();
                });
            }
            const tabBtn = document.getElementById("mc-tab");
            if (tabBtn) {
                const tabDown = (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    if (gameState === "PLAYING" || gameState === "GAMEOVER" || gameState === "ONLINE_LOBBY") {
                        showTabPlayers = true;
                    }
                };
                const tabUp = (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    showTabPlayers = false;
                };
                tabBtn.addEventListener("touchstart", tabDown, { passive: false });
                tabBtn.addEventListener("touchend", tabUp, { passive: false });
                tabBtn.addEventListener("touchcancel", tabUp, { passive: false });
                tabBtn.addEventListener("mousedown", tabDown);
                tabBtn.addEventListener("mouseup", tabUp);
            }
            const menuBtn = document.getElementById("mc-menu");
            if (menuBtn) {
                menuBtn.addEventListener("touchend", (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    if (chatOpen) { closeChat(false); return; }
                    if (gameState === "PLAYING" || gameState === "GAMEOVER" || gameState === "ONLINE_LOBBY") {
                        pauseMenuOpen = !pauseMenuOpen;
