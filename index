            const x = Math.round((canvas.width - w) / 2);
            const y = Math.round((canvas.height - h) / 2);
            ctx.fillStyle = "rgba(0, 0, 0, 0.82)";
            ctx.fillRect(x, y, w, h);
            ctx.strokeStyle = "#00ccaa";
            ctx.lineWidth = 2;
            ctx.strokeRect(x, y, w, h);
            ctx.fillStyle = "#00ccaa";
            ctx.font = "bold 15px 'Impact'";
            ctx.textAlign = "center";
            ctx.fillText("OYUNCULAR (TAB)", canvas.width / 2, y + 22);
            if (list.length === 0) {
                ctx.fillStyle = "#888";
                ctx.font = "12px monospace";
                ctx.fillText("Oyuncu yok", canvas.width / 2, y + h / 2 + 8);
                return;
            }
            list.forEach((lp, i) => {
                const py = y + 44 + i * 26;
                const rowX = x + 12;
                ctx.fillStyle = PLAYER_COLORS[(lp.id - 1) % PLAYER_COLORS.length];
                ctx.fillRect(rowX, py - 11, 4, 16);
                ctx.fillStyle = "#fff";
                ctx.font = "13px monospace";
                ctx.textAlign = "left";
                const nm = lp.name || ("P" + lp.id);
                ctx.fillText("P" + lp.id + "  " + nm + (lp.id === myPlayerId ? " ★" : ""), rowX + 12, py + 2);
            });
        }

        function drawLobbyPlayer(e) {
            // Normal mod karakter çizimine benzer
            let headColor = e.color;
            let bodyColor = e.color;
            try {
                const skinId = (typeof equippedSkins !== "undefined" && equippedSkins[e.id]) ? equippedSkins[e.id] : "default";
                const skinConfig = shopItems.find(item => item.id === skinId);
                if (skinConfig) {
                    if (skinConfig.head) headColor = skinConfig.head;
                    if (skinConfig.body) bodyColor = skinConfig.body;
                }
            } catch (err) {}

            const scale = 1;
            const headSize = 14 * scale;
            const headX = e.x + (e.w - headSize) / 2;
            const headY = e.y;
            const isFacingRight = (e.pushAnim && e.pushAnim > 0) ? (e.pushDir > 0) : (e.vx >= 0);
            const legSwing = Math.sin(e.animFrame || 0) * 4;

            ctx.fillStyle = headColor;
            ctx.fillRect(headX, headY, headSize, headSize);
            ctx.fillStyle = "#000000";
            const eyeX = isFacingRight ? headX + 7 * scale : headX + 2 * scale;
            ctx.fillRect(eyeX, headY + 4 * scale, 2 * scale, 3 * scale);
            ctx.fillRect(eyeX + 3 * scale, headY + 4 * scale, 2 * scale, 3 * scale);

            ctx.fillStyle = bodyColor;
            const bodyW = 16 * scale;
            const bodyH = 18 * scale;
            const bodyX = e.x + (e.w - bodyW) / 2;
            const bodyY = e.y + headSize;
            ctx.fillRect(bodyX, bodyY, bodyW, bodyH);

            // Kollar
            const armW = 4 * scale, armH = 12 * scale;
            if (isFacingRight) {
                ctx.fillRect(bodyX - armW + 2 * scale, bodyY + 2 * scale + Math.max(0, legSwing), armW, armH);
                ctx.fillRect(bodyX + bodyW - 2 * scale, bodyY + 2 * scale - Math.min(0, legSwing), armW, armH);
            } else {
                ctx.fillRect(bodyX - armW + 2 * scale, bodyY + 2 * scale - Math.min(0, legSwing), armW, armH);
                ctx.fillRect(bodyX + bodyW - 2 * scale, bodyY + 2 * scale + Math.max(0, legSwing), armW, armH);
            }

            // Bacaklar
            const legW = 5 * scale, legH = 12 * scale, legY = bodyY + bodyH;
            if (!e.onGround) {
                ctx.fillRect(bodyX + 1 * scale, legY, legW, legH - 3 * scale);
                ctx.fillRect(bodyX + bodyW - 6 * scale, legY - 2 * scale, legW, legH - 3 * scale);
            } else {
                ctx.fillRect(bodyX + 1 * scale, legY + Math.max(0, legSwing), legW, legH - Math.max(0, legSwing));
                ctx.fillRect(bodyX + bodyW - 6 * scale, legY - Math.min(0, legSwing), legW, legH + Math.min(0, legSwing));
            }

            // İsim
            ctx.fillStyle = "#fff";
            ctx.font = "bold 11px monospace";
            ctx.textAlign = "center";
            const label = (e.name || ("P" + e.id)) + (e.id === myPlayerId ? " ★" : "");
            ctx.fillText(label, e.x + e.w / 2, e.y - 8);
            // Sohbet baloncuğu
            const bub = speechBubbles[e.id];
            if (bub && bub.until > Date.now()) {
                drawSpeechBubble(e.x + e.w / 2, e.y - 10, bub.text, bub.color);
            } else if (bub) {
                delete speechBubbles[e.id];
            }
        }

