        * {
            box-sizing: border-box;
            image-rendering: pixelated;
            image-rendering: crisp-edges;
            font-family: 'Impact', 'Arial Black', sans-serif;
            user-select: none;
        }
        body {
            margin: 0;
            padding: 0;
            background-color: #05050a;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            color: #fff;
            overflow: hidden;
        }
        #game-container {
            position: relative;
            border: 6px solid #ff0055;
            box-shadow: 0 0 30px #ff0055;
        }
        canvas {
            background: #0d0e15;
            display: block;
            cursor: pointer;
        }
        #scoreboard {
            display: flex;
            justify-content: space-between;
            width: 800px;
            margin-top: 15px;
            background-color: #12131c;
            padding: 10px;
            border: 4px solid #333;
            visibility: hidden;
            flex-wrap: wrap;
            gap: 4px;
        }
        .player-score {
            padding: 8px 12px;
            font-weight: bold;
            font-size: 1.1rem;
            letter-spacing: 1px;
            border: 2px solid transparent;
        }
        .p1-color { border-color: #ff3366; color: #ff3366; }
        .p2-color { border-color: #33ccff; color: #33ccff; }
        .p3-color { border-color: #33ff66; color: #33ff66; }
        .p4-color { border-color: #ffff33; color: #ffff33; }
        .dead { text-decoration: line-through; opacity: 0.4; }
        #controls-info {
            margin-top: 15px;
            font-family: monospace;
            font-size: 0.85rem;
            color: #555875;
            text-align: center;
            line-height: 1.5;
        }
        #chat-box {
            display: none;
            position: absolute;
            left: 8px;
            bottom: 8px;
            width: 200px;
            max-height: 90px;
            overflow-y: auto;
            background: rgba(0,0,0,0.55);
            border: 1px solid rgba(0, 204, 170, 0.5);
            padding: 4px 6px;
            font-family: monospace;
            font-size: 10px;
            color: #ddd;
            pointer-events: none;
            z-index: 5;
            line-height: 1.25;
        }
        #chat-box .msg { margin: 1px 0; word-break: break-word; opacity: 0.9; }
        #chat-box .msg .n { color: #00ccaa; font-weight: bold; }
        #chat-input-wrap {
            display: none;
            position: absolute;
            left: 8px;
            bottom: 8px;
            width: 200px;
            z-index: 6;
        }
        #chat-input {
            width: 100%;
            padding: 5px 7px;
            background: rgba(18, 19, 28, 0.9);
            border: 1px solid #00ccaa;
            color: #fff;
            font-family: monospace;
            font-size: 12px;
            outline: none;
        }
        #net-status {
            position: absolute;
            top: 8px;
            right: 10px;
            font-family: monospace;
            font-size: 11px;
            color: #00ccaa;
            background: rgba(0,0,0,0.6);
            padding: 4px 8px;
            border-radius: 4px;
            display: none;
            z-index: 5;
        }
        /* Mobil metin girişi — sanal klavye için gerçek input */
        #mobile-text-wrap {
            display: none;
            position: fixed;
            left: 0;
            right: 0;
            bottom: 0;
            z-index: 10000;
            padding: 10px 12px calc(10px + env(safe-area-inset-bottom, 0px));
            background: rgba(10, 12, 20, 0.96);
            border-top: 2px solid #00ccaa;
            box-sizing: border-box;
        }
        #mobile-text-wrap.active { display: block; }
        #mobile-text-label {
            font-family: monospace;
            font-size: 11px;
            color: #00ccaa;
            margin-bottom: 6px;
        }
        #mobile-text-input {
            width: 100%;
            padding: 12px 14px;
            font-size: 16px;
            font-family: monospace;
            background: #15171f;
            border: 2px solid #00ccaa;
            color: #fff;
            border-radius: 6px;
            outline: none;
            box-sizing: border-box;
            -webkit-appearance: none;
            appearance: none;
        }
        #mobile-text-actions {
            display: flex;
            gap: 8px;
            margin-top: 8px;
        }
        #mobile-text-actions button {
            flex: 1;
            padding: 12px;
            font-family: 'Impact', 'Arial Black', sans-serif;
            font-size: 15px;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            -webkit-tap-highlight-color: transparent;
        }
        #mobile-text-ok { background: #00aa88; color: #000; }
        #mobile-text-cancel { background: #444; color: #fff; }
        #version-badge {
            position: fixed;
            right: 10px;
            bottom: 8px;
            z-index: 9999;
            font-family: monospace;
            font-size: 11px;
            color: rgba(255, 255, 255, 0.35);
            pointer-events: none;
            user-select: none;
            letter-spacing: 0.5px;
        }
        #chat-input {
            font-size: 16px;
            -webkit-appearance: none;
            appearance: none;
        }
        /* Mobil sanal kontroller */
        #mobile-controls {
            display: none;
            position: fixed;
            inset: 0;
            z-index: 8000;
            pointer-events: none;
            touch-action: none;
        }
        #mobile-controls.show { display: block; }
        .mc-btn {
            position: absolute;
            pointer-events: auto;
            -webkit-user-select: none;
            user-select: none;
            -webkit-tap-highlight-color: transparent;
            border: 2px solid rgba(0, 204, 170, 0.55);
            background: rgba(0, 0, 0, 0.42);
            color: #fff;
            font-family: 'Impact', 'Arial Black', sans-serif;
            font-size: 18px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            min-width: 58px;
            min-height: 58px;
            box-shadow: 0 0 12px rgba(0, 204, 170, 0.15);
        }
        .mc-btn:active, .mc-btn.pressed {
            background: rgba(0, 204, 170, 0.45);
            border-color: #00ffcc;
            transform: scale(0.96);
        }
        #mc-left { left: 14px; bottom: 88px; width: 70px; height: 70px; font-size: 28px; }
        #mc-right { left: 94px; bottom: 88px; width: 70px; height: 70px; font-size: 28px; }
        #mc-jump { right: 14px; bottom: 88px; width: 78px; height: 70px; font-size: 15px; }
        #mc-shoot { right: 100px; bottom: 88px; width: 70px; height: 70px; font-size: 15px; background: rgba(255, 0, 85, 0.28); border-color: rgba(255, 0, 85, 0.6); }
        #mc-chat { right: 14px; top: 54px; width: 56px; height: 44px; font-size: 13px; min-height: 44px; }
        #mc-tab { right: 78px; top: 54px; width: 56px; height: 44px; font-size: 12px; min-height: 44px; }
        #mc-menu { left: 14px; top: 54px; width: 56px; height: 44px; font-size: 12px; min-height: 44px; }
        @media (max-width: 900px) {
            canvas {
                width: 100% !important;
                height: auto !important;
                max-height: 62vh;
            }
            #scoreboard {
                width: 100% !important;
                max-width: 100vw;
            }
            #version-badge { bottom: 4px; font-size: 10px; }
        }
    </style>
</head>
<body>
    <div id="game-container">
        <canvas id="gameCanvas" width="800" height="500"></canvas>
        <div id="chat-box"></div>
        <div id="chat-input-wrap"><input id="chat-input" type="text" maxlength="120" placeholder="Mesaj yaz... (Enter gönder, Esc iptal)" autocomplete="off" inputmode="text" enterkeyhint="send"></div>
        <div id="net-status"></div>
    </div>
    <div id="mobile-controls" aria-hidden="true">
        <div class="mc-btn" id="mc-menu" data-act="menu">MENÜ</div>
        <div class="mc-btn" id="mc-tab" data-act="tab">TAB</div>
        <div class="mc-btn" id="mc-chat" data-act="chat">CHAT</div>
        <div class="mc-btn" id="mc-left" data-act="left">◀</div>
        <div class="mc-btn" id="mc-right" data-act="right">▶</div>
        <div class="mc-btn" id="mc-jump" data-act="jump">ZIPLA</div>
        <div class="mc-btn" id="mc-shoot" data-act="shoot">ATEŞ</div>
    </div>
