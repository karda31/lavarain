            // Sağ Shift: host maçı başlatır (lobi / game over)
            if (e.code === "ShiftRight") {
                if (isOnline && isHost && !chatOpen && !pauseMenuOpen) {
                    if (gameState === "ONLINE_LOBBY" || gameState === "GAMEOVER") {
                        hostStartMatch();
