                    });
                } else if (passwordPrompt.active) {
                    const srv = (passwordPrompt.targetId
                        ? serverList.find(s => String(s.id).toUpperCase() === String(passwordPrompt.targetId).toUpperCase())
                        : null) || getFilteredServers()[passwordPrompt.targetIndex] || serverList[passwordPrompt.targetIndex];
                    if (srv && passwordMatchesLocal(srv, passwordPrompt.input)) {
