        <div id="mobile-text-actions">
            <button type="button" id="mobile-text-ok">TAMAM</button>
            <button type="button" id="mobile-text-cancel">İPTAL</button>
        </div>
    </div>
    <div id="version-badge">V1.2 Beta</div>
    <audio id="menuMusic" loop preload="auto">
        <source src="Iron_key.mp3" type="audio/mpeg">
    </audio>
    <div id="scoreboard">
        <div id="p1-card" class="player-score p1-color">P1: <span id="s1">0</span></div>
        <div id="p2-card" class="player-score p2-color">P2: <span id="s2">0</span></div>
