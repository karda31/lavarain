        function destroyPeer() {
            // Host çıkınca oda boşalır → listeden kaldır
            const wasHost = isHost;
            const code = roomCode;
            try {
                Object.values(connections).forEach(c => { try { c.close(); } catch(e){} });
                if (hostConn) try { hostConn.close(); } catch(e){}
                if (peer) try { peer.destroy(); } catch(e){}
            } catch (e) {}
            peer = null;
            hostConn = null;
            connections = {};
            peerIdToPlayer = {};
            playerIdToPeer = {};
            isOnline = false;
            isHost = false;
            isInLobby = false;
            remoteInputs = {};
            lobbyEntities = {};
            lobbyPlayers = [];
            hostPaused = false;
            bannedNames = {};
            bannedPeerIds = {};
            setNetStatus("");
            document.getElementById("chat-box").style.display = "none";
            document.getElementById("chat-input-wrap").style.display = "none";
            if (wasHost && code) removeServerFromList(code);
            roomCode = "";
        }

        function genRoomCode() {
            const chars = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789";
            let s = "";
            for (let i = 0; i < 6; i++) s += chars[Math.floor(Math.random() * chars.length)];
            return s;
        }

        function hostCreateRoom(cfg) {
            loadServers();
            const wantName = String(cfg.name || "").trim();
            if (wantName.length < 2) {
                setNetStatus("Sunucu adı en az 2 karakter olmalı");
                return;
            }
            if (isServerNameTaken(wantName)) {
                setNetStatus("Bu isimde sunucu zaten var: " + wantName);
                addChat("Sistem", "Aynı isimde sunucu kurulamaz: \"" + wantName + "\"", "#ff4455");
                gameState = "CREATE_SERVER";
                return;
            }
            destroyPeer();
            roomCode = genRoomCode();
            roomPassword = cfg.password || "";
            roomMaxPlayers = Math.min(8, Math.max(2, cfg.maxPlayers || 4));
            roomName = wantName.slice(0, 24);
            activeMapId = cfg.map || "classic";
            activeGameMode = cfg.mode || "classic";
            applyMapSettings(activeMapId);
            isHost = true;
            isOnline = true;
            myPlayerId = 1;
            onlinePlayerNames = { 1: "Host" };
            lobbyPlayers = [{ id: 1, name: "Host", ready: true }];
            isInLobby = true;
            lobbyEntities = {};
            ensureLobbyEntity(1, "Host");
            chatMessages = [];
            setNetStatus("Bağlanıyor... Kod: " + roomCode);

            peer = new Peer("lavarain-" + roomCode, { debug: 0 });
            peer.on("open", (id) => {
                myPeerId = id;
                setNetStatus("ODA: " + roomCode + " | Bekleniyor...");
                addChat("Sistem", "Oda oluşturuldu. Kod: " + roomCode, "#ffaa00");
                addChat("Sistem", "Lobi parkuru: platformlar + yeşil slime trambolin! İttir, zıpla. ESC = menü.", "#88ff88");
                const now = Date.now();
                // Aynı isimli eski hayalet kayıtları sil
                serverList = serverList.filter(s =>
                    String(s.id).toUpperCase() !== roomCode &&
                    normalizeServerName(s.name) !== normalizeServerName(roomName)
                );
                const entry = {
                    id: roomCode,
                    name: roomName,
                    password: roomPassword,
                    maxPlayers: roomMaxPlayers,
                    map: activeMapId,
                    mapName: (MAPS.find(m => m.id === activeMapId) || {}).name || activeMapId,
                    mode: activeGameMode,
                    modeName: (GAME_MODES.find(m => m.id === activeGameMode) || {}).nameKey || activeGameMode,
                    createdAt: now,
                    updatedAt: now,
                    online: true,
                    active: true,
                    players: 1
                };
                serverList.unshift(entry);
                saveServers();
                ensureDiscoveryConnection();
                publishServerToDiscovery(entry);
                gameState = "ONLINE_LOBBY";
            });
            peer.on("connection", (conn) => {
                conn.on("open", () => {
                    connections[conn.peer] = conn;
                    conn.on("data", (raw) => handleHostData(conn, raw));
                    conn.on("close", () => onClientDisconnect(conn.peer, "disconnect"));
                    conn.on("error", () => onClientDisconnect(conn.peer, "timeout"));
                });
            });
            peer.on("error", (err) => {
                setNetStatus("Hata: " + (err.type || err.message || "bağlantı"));
                if (err.type === "unavailable-id") {
                    // kod çakışması, yeniden dene
                    setTimeout(() => hostCreateRoom(cfg), 300);
                }
            });
        }

        function clientJoinRoom(code, password, displayName) {
            destroyPeer();
            roomCode = (code || "").toUpperCase().replace(/[^A-Z0-9]/g, "").slice(0, 8);
            if (roomCode.length < 4) {
                setNetStatus("Geçersiz oda kodu");
                return;
            }
            isHost = false;
            isOnline = true;
            isInLobby = true;
            chatMessages = [];
            pendingJoin = { password: password || "", name: (displayName || "Oyuncu").slice(0, 12) };
            setNetStatus("Katılınıyor: " + roomCode + "...");

            peer = new Peer({ debug: 0 });
            peer.on("open", (id) => {
                myPeerId = id;
                hostConn = peer.connect("lavarain-" + roomCode, { reliable: true });
                hostConn.on("open", () => {
                    setNetStatus("Doğrulanıyor...");
                    netSendTo(hostConn, {
                        type: "join",
                        password: pendingJoin.password,
                        name: pendingJoin.name
                    });
                });
                hostConn.on("data", (raw) => handleClientData(raw));
                hostConn.on("close", () => {
                    setNetStatus("Bağlantı koptu — host ayrıldı");
                    if (gameState === "PLAYING" || gameState === "GAMEOVER" || gameState === "ONLINE_LOBBY") {
                        addChat("Sistem", "Host sunucudan ayrıldı. Oda kapandı.", "#ff4455");
                        addChat("Sistem", "Ana menüye dönmek için sayfayı yenileyebilir veya AYRIL kullanabilirsin.", "#ffaa66");
                    }
                });
                hostConn.on("error", () => {
                    setNetStatus("Bağlantı hatası");
                    addChat("Sistem", "Host ile bağlantı hatası oluştu.", "#ff4455");
                });
            });
            peer.on("error", (err) => {
                const t = (err && err.type) || "";
                setNetStatus("Hata: " + (t || "oda bulunamadı"));
                // Oda yok / boş / kapalı → listeden kaldır
                if (t === "peer-unavailable" || t === "network" || t === "server-error" || !t) {
                    removeServerFromList(roomCode);
                }
                isOnline = false;
                isHost = false;
                gameState = "SERVERS";
            });
        }

        function handleHostData(conn, raw) {
            let msg;
            try { msg = typeof raw === "string" ? JSON.parse(raw) : raw; } catch (e) { return; }
            if (!msg || !msg.type) return;

            if (msg.type === "join") {
                const joinName = (msg.name || "").slice(0, 12);
                if (bannedPeerIds[conn.peer] || bannedNames[String(joinName).toLowerCase()]) {
                    netSendTo(conn, { type: "join_fail", reason: "Bu odadan banlandın" });
                    conn.close();
                    return;
                }
                const count = Object.keys(peerIdToPlayer).length + 1; // +host
                if (count >= roomMaxPlayers) {
                    netSendTo(conn, { type: "join_fail", reason: "Oda dolu" });
                    conn.close();
                    return;
                }
                if (roomPassword && msg.password !== roomPassword) {
                    netSendTo(conn, { type: "join_fail", reason: "Yanlış şifre" });
                    conn.close();
                    return;
                }
                // assign player id
                let pid = 2;
                const used = new Set(Object.values(peerIdToPlayer));
                used.add(1);
                while (used.has(pid) && pid <= 8) pid++;
                if (pid > 8) {
                    netSendTo(conn, { type: "join_fail", reason: "Oda dolu" });
                    conn.close();
                    return;
                }
                peerIdToPlayer[conn.peer] = pid;
                playerIdToPeer[pid] = conn.peer;
                const pname = (msg.name || ("P" + pid)).slice(0, 12);
                onlinePlayerNames[pid] = pname;
                lobbyPlayers.push({ id: pid, name: pname, ready: false });
                remoteInputs[pid] = { left: false, right: false, jump: false };
                ensureLobbyEntity(pid, pname);

                netSendTo(conn, {
                    type: "join_ok",
                    playerId: pid,
                    roomCode,
                    roomName,
                    map: activeMapId,
                    mode: activeGameMode,
                    maxPlayers: roomMaxPlayers,
                    players: lobbyPlayers,
                    names: onlinePlayerNames
                });
                // herkese güncel lobby
                netSend({ type: "lobby", players: lobbyPlayers, names: onlinePlayerNames });
                broadcastSystem(pname + " (P" + pid + ") sunucuya katıldı! (" + lobbyPlayers.length + "/" + roomMaxPlayers + ")", "#88ff88");
                setNetStatus("ODA: " + roomCode + " | " + lobbyPlayers.length + "/" + roomMaxPlayers);
                updateServerListPlayers();
            }
            else if (msg.type === "input") {
                if (hostPaused) return;
                const pid = peerIdToPlayer[conn.peer];
                if (pid) remoteInputs[pid] = {
                    left: !!msg.left, right: !!msg.right, jump: !!msg.jump, shoot: !!msg.shoot
                };
            }
            else if (msg.type === "chat") {
                addChat(msg.name || "?", msg.text || "", msg.color, msg.playerId);
                // relay
                Object.values(connections).forEach(c => {
                    if (c !== conn && c.open) netSendTo(c, msg);
                });
            }
            else if (msg.type === "leave") {
                onClientDisconnect(conn.peer, "leave");
                try { conn.close(); } catch (e) {}
            }
            else if (msg.type === "ready") {
                const pid = peerIdToPlayer[conn.peer];
                const lp = lobbyPlayers.find(p => p.id === pid);
                if (lp) lp.ready = true;
                netSend({ type: "lobby", players: lobbyPlayers, names: onlinePlayerNames });
            }
            else if (msg.type === "request_return_lobby") {
                // Client lobi istedi — host herkesi lobiye alır
                if (gameState === "PLAYING" || gameState === "GAMEOVER") {
                    returnToOnlineLobby();
                }
            }
        }

        function handleClientData(raw) {
            let msg;
            try { msg = typeof raw === "string" ? JSON.parse(raw) : raw; } catch (e) { return; }
            if (!msg || !msg.type) return;

            if (msg.type === "join_ok") {
                myPlayerId = msg.playerId;
                roomName = msg.roomName || roomCode;
                activeMapId = msg.map || "classic";
                applyMapSettings(activeMapId);
                roomMaxPlayers = msg.maxPlayers || 4;
                lobbyPlayers = msg.players || [];
                onlinePlayerNames = msg.names || {};
                onlinePlayerNames[myPlayerId] = onlinePlayerNames[myPlayerId] || ("P" + myPlayerId);
                lobbyEntities = {};
                syncLobbyEntitiesFromPlayers();
                setNetStatus("ODA: " + roomCode + " | P" + myPlayerId);
                const myName = onlinePlayerNames[myPlayerId] || ("P" + myPlayerId);
                addChat("Sistem", "Odaya katıldın! Sen: " + myName + " (P" + myPlayerId + ")", "#88ff88");
                addChat("Sistem", "Oda: " + (roomName || roomCode) + " | Harita: " + activeMapId, "#88aacc");
                addChat("Sistem", "Lobi parkuru aktif! WASD / Oklarla dolaş. ESC = çıkış.", "#ffcc00");
                gameState = "ONLINE_LOBBY";
            }
            else if (msg.type === "join_fail") {
                setNetStatus("Red: " + (msg.reason || "hata"));
                // Oda dolu/şifre yanlış dışındaki durumlarda (yoksa) listeden sil
                const reason = (msg.reason || "").toLowerCase();
                if (reason.includes("bulun") || reason.includes("yok") || reason.includes("kapalı") || reason.includes("empty")) {
                    removeServerFromList(roomCode);
                }
                // Şifre yanlış veya dolu → listede kalsın (oda aktif)
                const keepCode = roomCode;
                destroyPeer();
                // destroyPeer host değilse room silmez; client tarafında peer-unavailable için ayrıca
                gameState = "SERVERS";
            }
            else if (msg.type === "lobby") {
                lobbyPlayers = msg.players || lobbyPlayers;
                onlinePlayerNames = msg.names || onlinePlayerNames;
                syncLobbyEntitiesFromPlayers();
            }
            else if (msg.type === "lobby_state") {
                applyLobbyState(msg);
            }
            else if (msg.type === "return_lobby") {
                applyReturnLobby(msg);
            }
            else if (msg.type === "host_pause") {
                hostPaused = !!msg.paused;
            }
            else if (msg.type === "kicked") {
                addChat("Sistem", msg.reason || "Odadan atıldın.", "#ff4455");
                setNetStatus("Atıldın");
                setTimeout(() => {
                    destroyPeer();
                    gameState = "MAIN_MENU";
                    hostPaused = false;
                    document.getElementById("scoreboard").style.visibility = "hidden";
                    tryStartMusic();
                }, 400);
            }
            else if (msg.type === "start") {
                applyMapSettings(msg.map || activeMapId);
                startOnlineMatch(msg);
            }
            else if (msg.type === "state") {
                applyNetworkState(msg);
            }
            else if (msg.type === "chat") {
                addChat(msg.name || "?", msg.text || "", msg.color, msg.playerId);
            }
            else if (msg.type === "gameover") {
                gameState = "GAMEOVER";
                winnerText = msg.winnerText || "OYUN BİTTİ";
                winnerColor = msg.winnerColor || "#fff";
                if (msg.players) {
                    msg.players.forEach(sp => {
                        const p = players.find(x => x.id === sp.id);
                        if (p) { p.score = sp.score; p.isDead = sp.isDead; p.hp = sp.hp; }
                        const el = document.getElementById("s" + sp.id);
                        if (el) el.innerText = sp.score;
                    });
                }
            }
            else if (msg.type === "restart") {
                startOnlineMatch(msg);
            }
        }

        function broadcastSystem(text, color) {
            addChat("Sistem", text, color || "#ff8855");
            netSend({ type: "chat", name: "Sistem", text: text, color: color || "#ff8855" });
        }

        function onClientDisconnect(peerId, reason) {
            const pid = peerIdToPlayer[peerId];
            delete connections[peerId];
            if (pid) {
                delete peerIdToPlayer[peerId];
                delete playerIdToPeer[pid];
                delete remoteInputs[pid];
                const name = onlinePlayerNames[pid] || ("P" + pid);
                lobbyPlayers = lobbyPlayers.filter(p => p.id !== pid);
                delete onlinePlayerNames[pid];
                delete lobbyEntities[pid];

                let msg = "";
                if (reason === "leave") {
                    if (gameState === "PLAYING" || gameState === "GAMEOVER") {
                        msg = name + " (P" + pid + ") oyundan ayrıldı.";
                    } else {
                        msg = name + " (P" + pid + ") lobiden ayrıldı.";
                    }
                } else if (reason === "timeout") {
                    msg = name + " (P" + pid + ") bağlantı zaman aşımına uğradı.";
                } else if (reason === "kick") {
                    msg = name + " (P" + pid + ") odadan atıldı.";
                } else {
                    if (gameState === "PLAYING" || gameState === "GAMEOVER") {
                        msg = name + " (P" + pid + ") bağlantısı koptu — sunucudan ayrıldı.";
                    } else {
                        msg = name + " (P" + pid + ") sunucudan ayrıldı.";
                    }
                }
                broadcastSystem(msg, "#ff8855");

                const kalan = lobbyPlayers.length;
                if (kalan <= 1) {
                    broadcastSystem("Odada " + kalan + " kişi kaldı.", "#ffaa66");
                } else {
                    broadcastSystem("Kalan oyuncu: " + kalan + "/" + roomMaxPlayers, "#88aacc");
                }

                netSend({ type: "lobby", players: lobbyPlayers, names: onlinePlayerNames });
                setNetStatus("ODA: " + roomCode + " | " + lobbyPlayers.length + "/" + roomMaxPlayers);
                updateServerListPlayers();

                if (gameState === "PLAYING") {
                    const p = players.find(x => x.id === pid);
                    if (p && !p.isDead) {
                        p.isDead = true;
                        p.hp = 0;
                        const card = document.getElementById("p" + pid + "-card");
                        if (card) card.classList.add("dead");
                        broadcastSystem(name + " (P" + pid + ") oyuncu olarak elendi (ayrıldığı için).", "#ff6644");
                    }
                }
            }
        }

        function hostStartMatch() {
            if (!isHost) return;
            const count = lobbyPlayers.length;
            if (count < 1) return;
            isInLobby = false;
            const payload = {
                type: "start",
                map: activeMapId,
                mode: activeGameMode,
                playerIds: lobbyPlayers.map(p => p.id),
                names: onlinePlayerNames,
                maxPlayers: count
            };
            netSend(payload);
            startOnlineMatch(payload);
        }

        function startOnlineMatch(msg) {
            pauseMenuOpen = false;
            hostPaused = false;
            isDuelMode = false;
            isTestMode = false;
            const ids = (msg && msg.playerIds) ? msg.playerIds : lobbyPlayers.map(p => p.id);
            activePlayerCount = Math.max(1, ids.length);
            if (msg && msg.names) onlinePlayerNames = msg.names;
            if (msg && msg.mode) activeGameMode = msg.mode;
            applyMapSettings((msg && msg.map) || activeMapId);

            // build players from ids
            const base = {
                x: 150, y: 300, vx: 0, vy: 0, width: 24, height: 44,
                score: 0, hp: 3, maxHp: 3, isDead: false, shieldTime: 0, onGround: false, animFrame: 0
            };
            players = ids.map((id, idx) => {
                const p = Object.assign({}, base, {
                    id: id,
                    x: 80 + idx * Math.floor(640 / Math.max(1, ids.length)),
                    color: PLAYER_COLORS[(id - 1) % PLAYER_COLORS.length],
                    leftKey: null, rightKey: null, jumpKey: null,
                    remote: id !== myPlayerId || !isHost ? true : false
                });
                // host local always uses WASD for own character; clients too for their own
                return p;
            });
            players.forEach(p => {
                // skin: host uses own store for all if host, client only own
                const skinOwner = isHost ? p.id : (p.id === myPlayerId ? myPlayerId : p.id);
                // for simplicity everyone uses default online unless we sync skins — use local equipped for self only
                if (p.id === myPlayerId) {
                    applySkinPowers(p);
                } else {
                    applySkinPowers(Object.assign(p, { id: p.id }));
