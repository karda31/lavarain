                setNetStatus("ODA: " + roomCode + " | " + lobbyPlayers.length + "/" + roomMaxPlayers);
            } else {
                // client sadece bekler; host mesajı gelince döner
                netSend({ type: "request_return_lobby", playerId: myPlayerId });
            }
        }

        function applyReturnLobby(msg) {
