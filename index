        }, { passive: false });

        function canvasCoords(clientX, clientY) {
            const rect = canvas.getBoundingClientRect();
            const scaleX = canvas.width / Math.max(1, rect.width);
            const scaleY = canvas.height / Math.max(1, rect.height);
            return {
                x: (clientX - rect.left) * scaleX,
                y: (clientY - rect.top) * scaleY
            };
        }

        canvas.addEventListener("mousedown", (e) => {
            if (gameState !== "SETTINGS" || settingsTab !== "ses") return;
            const { x: mouseX, y: mouseY } = canvasCoords(e.clientX, e.clientY);
            if (mouseX >= 100 && mouseX <= 500 && mouseY >= 160 && mouseY <= 210) {
                volumeDragging = true;
                settings.masterVolume = Math.max(0, Math.min(1, (mouseX - 100) / 400));
                saveSettings();
