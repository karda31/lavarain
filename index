            if (msg.shields) shields = msg.shields;
            if (msg.weapons) weapons = msg.weapons;
            if (msg.bullets) bullets = msg.bullets;
            if (msg.players) {
                msg.players.forEach(sp => {
                    let p = players.find(x => x.id === sp.id);
                    if (!p) {
                        p = {
                            id: sp.id, color: PLAYER_COLORS[(sp.id - 1) % PLAYER_COLORS.length],
