                    if (mouseX >= 400 && mouseX <= 540 && mouseY >= 180 && mouseY <= 230) { settings.language = "de"; saveSettings(); }
                    if (mouseX >= 560 && mouseX <= 700 && mouseY >= 180 && mouseY <= 230) { settings.language = "ru"; saveSettings(); }
                } else if (settingsTab === "kontrol") {
