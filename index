                    const filtered = getFilteredServers();
                    if (filtered.length === 0) return;
                    if (selectedServerIndex < 0) {
                        selectedServerIndex = e.code === "ArrowDown" ? 0 : filtered.length - 1;
                    } else {
                        selectedServerIndex += (e.code === "ArrowDown" ? 1 : -1);
                        selectedServerIndex = Math.max(0, Math.min(filtered.length - 1, selectedServerIndex));
                    }
                    // Seçili satır görünür alanda kalsın
                    if (selectedServerIndex < serverScroll) serverScroll = selectedServerIndex;
