                } else if (e.code === "Enter" && selectedServerIndex >= 0) {
                    const filtered = getFilteredServers();
                    const srv = filtered[selectedServerIndex];
                    if (srv) {
                        if (serverNeedsPassword(srv)) {
                            passwordPrompt = { active: true, input: "", targetIndex: selectedServerIndex, targetId: srv.id, error: "" };
                            openMobileText({
                                kind: "passwordPrompt",
                                field: "input",
