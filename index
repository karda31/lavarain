        });
        window.addEventListener("mousemove", (e) => {
            if (!volumeDragging) return;
            const { x: mouseX } = canvasCoords(e.clientX, e.clientY);
            settings.masterVolume = Math.max(0, Math.min(1, (mouseX - 100) / 400));
