        const menuMusic = document.getElementById("menuMusic");
        menuMusic.volume = 0.45;
        let musicStarted = false;

        function tryStartMusic() {
            if (gameState === "MAIN_MENU" && menuMusic.paused) {
                menuMusic.play().then(() => { musicStarted = true; }).catch(() => {});
            }
        }
        document.addEventListener("DOMContentLoaded", tryStartMusic);
        window.addEventListener("load", tryStartMusic);
        window.addEventListener("click", tryStartMusic);
        window.addEventListener("keydown", tryStartMusic);
        window.addEventListener("touchstart", tryStartMusic, { once: true });

        let inputBuffer = "";
        const cheatCode = "testroom";
        let isTestMode = false;
        let isDuelMode = false;
        let gameState = "MAIN_MENU";
        let activePlayerCount = 4;

