        // --- Cihazlar arası sunucu listesi (PeerJS discovery hub) ---
        const DISCOVERY_PEER_ID = "lavarain-hub-v11";
        let discoveryPeer = null;
        let discoveryConn = null;
        let isDiscoveryHub = false;
        let discoveryHubList = []; // hub tarafında tutulan global liste
        let discoveryClients = {}; // hub: peerId -> conn
        let lastDiscoveryPush = 0;

        function mergeServerEntry(list, entry) {
            if (!entry || !entry.id) return list;
            const id = String(entry.id).toUpperCase();
            const idx = list.findIndex(s => String(s.id).toUpperCase() === id);
            if (idx >= 0) list[idx] = Object.assign({}, list[idx], entry);
            else list.unshift(entry);
            return list;
        }

        function publishServerToDiscovery(entry) {
            if (!entry || !entry.id) return;
            // Şifreyi yayına çıkarma — sadece kilit bayrağı
            const safe = Object.assign({}, entry, {
                password: entry.password ? "__SET__" : "",
                hasPassword: !!(entry.password && entry.password.length)
            });
            const payload = { type: "advertise", server: safe };
            if (isDiscoveryHub) {
                discoveryHubList = mergeServerEntry(discoveryHubList.filter(s => String(s.id).toUpperCase() !== String(entry.id).toUpperCase()), safe);
                discoveryHubList = discoveryHubList.filter(s => {
                    const last = s.updatedAt || s.createdAt || 0;
                    return last && (Date.now() - last) < SERVER_STALE_MS && s.players > 0;
                });
                broadcastDiscoveryList();
            } else if (discoveryConn && discoveryConn.open) {
                try { discoveryConn.send(JSON.stringify(payload)); } catch (e) {}
            } else {
                ensureDiscoveryConnection();
            }
        }

        function removeServerFromDiscovery(code) {
            if (!code) return;
            const payload = { type: "remove", id: code };
            if (isDiscoveryHub) {
                discoveryHubList = discoveryHubList.filter(s => String(s.id).toUpperCase() !== String(code).toUpperCase());
                broadcastDiscoveryList();
            } else if (discoveryConn && discoveryConn.open) {
                try { discoveryConn.send(JSON.stringify(payload)); } catch (e) {}
            }
        }

        function broadcastDiscoveryList() {
            if (!isDiscoveryHub) return;
            const now = Date.now();
            if (now - lastDiscoveryPush < 400) return;
            lastDiscoveryPush = now;
            const data = JSON.stringify({ type: "list", servers: discoveryHubList });
            Object.values(discoveryClients).forEach(c => {
                if (c && c.open) try { c.send(data); } catch (e) {}
            });
        }

        function applyRemoteServerList(list) {
            if (!Array.isArray(list)) return;
            const now = Date.now();
            const remote = list.filter(s => {
                if (!s || !s.id) return false;
                if (s.players == null || Number(s.players) <= 0) return false;
                if (s.active === false || s.online === false) return false;
                const last = s.updatedAt || s.createdAt || 0;
                return last && (now - last) < SERVER_STALE_MS;
            });
            // Yerel + uzak birleştir (kod unique)
            const map = {};
            serverList.forEach(s => { if (s && s.id) map[String(s.id).toUpperCase()] = s; });
            remote.forEach(s => {
                const k = String(s.id).toUpperCase();
                const prev = map[k];
                if (!prev || (s.updatedAt || 0) >= (prev.updatedAt || 0)) map[k] = s;
            });
            serverList = Object.values(map).sort((a, b) => (b.updatedAt || 0) - (a.updatedAt || 0));
            try { localStorage.setItem("lavaRainServers", JSON.stringify(serverList)); } catch (e) {}
        }

        function ensureDiscoveryConnection() {
            if (discoveryPeer && !discoveryPeer.destroyed) return;
            try {
                discoveryPeer = new Peer(DISCOVERY_PEER_ID, { debug: 0 });
            } catch (e) {
                discoveryPeer = new Peer({ debug: 0 });
            }
            discoveryPeer.on("open", (id) => {
                if (id === DISCOVERY_PEER_ID) {
                    // Bu tarayıcı hub oldu
                    isDiscoveryHub = true;
                    discoveryHubList = [];
                    discoveryPeer.on("connection", (conn) => {
                        conn.on("open", () => {
                            discoveryClients[conn.peer] = conn;
                            try { conn.send(JSON.stringify({ type: "list", servers: discoveryHubList })); } catch (e) {}
                            conn.on("data", (raw) => handleDiscoveryData(conn, raw));
                            conn.on("close", () => { delete discoveryClients[conn.peer]; });
                        });
                    });
                } else {
                    // Hub başka birinde — bağlan
                    isDiscoveryHub = false;
                    connectToDiscoveryHub();
                }
            });
            discoveryPeer.on("error", (err) => {
                if (err && (err.type === "unavailable-id" || String(err).includes("taken"))) {
                    // Hub zaten var — anonim peer ile bağlan
                    try { discoveryPeer.destroy(); } catch (e) {}
                    discoveryPeer = new Peer({ debug: 0 });
                    discoveryPeer.on("open", () => {
                        isDiscoveryHub = false;
                        connectToDiscoveryHub();
                    });
                    discoveryPeer.on("error", () => {});
                }
            });
        }

        function connectToDiscoveryHub() {
            if (!discoveryPeer || discoveryPeer.destroyed) return;
            try {
                if (discoveryConn) try { discoveryConn.close(); } catch (e) {}
                discoveryConn = discoveryPeer.connect(DISCOVERY_PEER_ID, { reliable: true });
                discoveryConn.on("open", () => {
                    try { discoveryConn.send(JSON.stringify({ type: "request_list" })); } catch (e) {}
                    // Host isek hemen reklam ver
                    if (isHost && roomCode) {
                        updateServerListPlayers();
                    }
                });
                discoveryConn.on("data", (raw) => handleDiscoveryData(discoveryConn, raw));
                discoveryConn.on("close", () => {
                    discoveryConn = null;
                    setTimeout(() => { if (!isDiscoveryHub) connectToDiscoveryHub(); }, 3000);
                });
                discoveryConn.on("error", () => {});
            } catch (e) {}
        }

        function handleDiscoveryData(conn, raw) {
            let msg;
            try { msg = typeof raw === "string" ? JSON.parse(raw) : raw; } catch (e) { return; }
            if (!msg || !msg.type) return;
            if (isDiscoveryHub) {
                if (msg.type === "advertise" && msg.server) {
                    discoveryHubList = mergeServerEntry(discoveryHubList, msg.server);
                    broadcastDiscoveryList();
                } else if (msg.type === "remove" && msg.id) {
                    discoveryHubList = discoveryHubList.filter(s => String(s.id).toUpperCase() !== String(msg.id).toUpperCase());
                    broadcastDiscoveryList();
                } else if (msg.type === "request_list") {
                    try { conn.send(JSON.stringify({ type: "list", servers: discoveryHubList })); } catch (e) {}
                }
            } else {
                if (msg.type === "list") {
                    applyRemoteServerList(msg.servers || []);
                }
            }
        }

        function loadServers() {
            try {
                const raw = localStorage.getItem("lavaRainServers");
                let list = raw ? JSON.parse(raw) : [];
                const now = Date.now();
                serverList = list.filter(s => {
                    if (!s || s.active === false || s.online === false) return false;
                    if (s.players == null || Number(s.players) <= 0) return false;
                    const last = s.updatedAt || s.createdAt || 0;
                    if (!last || (now - last) > SERVER_STALE_MS) return false;
                    return true;
                });
                if (serverList.length !== list.length) {
                    try { localStorage.setItem("lavaRainServers", JSON.stringify(serverList)); } catch (e2) {}
                }
            } catch (e) {
                serverList = [];
            }
            // Uzak listeyi de çek
            ensureDiscoveryConnection();
            if (discoveryConn && discoveryConn.open) {
                try { discoveryConn.send(JSON.stringify({ type: "request_list" })); } catch (e) {}
            }
        }
        function saveServers() {
            try {
                pruneStaleServers();
                serverList = serverList.filter(s => s && s.active !== false && s.online !== false && s.players != null && Number(s.players) > 0);
                localStorage.setItem("lavaRainServers", JSON.stringify(serverList));
            } catch (e) {}
        }
        function updateServerListPlayers() {
            if (!isHost || !roomCode) return;
            // Lobide lobbyPlayers, maçta canlı oyuncu sayısı
            let n = 0;
            if (gameState === "PLAYING" || gameState === "GAMEOVER") {
                n = (players || []).filter(p => p && !p.isDead).length;
                if (n <= 0) n = (lobbyPlayers && lobbyPlayers.length) || 0;
            } else {
                n = (lobbyPlayers && lobbyPlayers.length) || 0;
            }
            const idx = serverList.findIndex(s => String(s.id).toUpperCase() === String(roomCode).toUpperCase());
            if (n <= 0) {
                removeServerFromList(roomCode);
                return;
            }
            let entry;
            if (idx >= 0) {
                serverList[idx].players = n;
                serverList[idx].active = true;
                serverList[idx].online = true;
                serverList[idx].updatedAt = Date.now();
                entry = serverList[idx];
                saveServers();
            } else {
                entry = {
                    id: roomCode,
                    name: roomName || roomCode,
                    password: roomPassword || "",
                    maxPlayers: roomMaxPlayers,
                    map: activeMapId,
                    mapName: (MAPS.find(m => m.id === activeMapId) || {}).name || activeMapId,
                    mode: activeGameMode,
                    modeName: (GAME_MODES.find(m => m.id === activeGameMode) || {}).nameKey || activeGameMode,
                    createdAt: Date.now(),
                    updatedAt: Date.now(),
                    online: true,
                    active: true,
                    players: n
                };
                serverList.unshift(entry);
                saveServers();
            }
            publishServerToDiscovery(entry);
        }
        loadServers();
        ensureDiscoveryConnection();

        // Host sayfa kapanınca odayı listeden sil
        window.addEventListener("beforeunload", () => {
            if (isHost && roomCode) {
                try {
                    const raw = localStorage.getItem("lavaRainServers");
                    let list = raw ? JSON.parse(raw) : [];
                    list = list.filter(s => String(s.id).toUpperCase() !== String(roomCode).toUpperCase());
                    localStorage.setItem("lavaRainServers", JSON.stringify(list));
                } catch (e) {}
                removeServerFromDiscovery(roomCode);
            }
        });

        // Host canlıyken periyodik heartbeat (hayalet oda olmasın)
        setInterval(() => {
            if (isHost && isOnline && roomCode) updateServerListPlayers();
            else pruneStaleServers();
        }, 12000);
        setInterval(() => { pruneStaleServers(); }, 15000);

        function applyMapSettings(mapId) {
            activeMapId = mapId || "classic";
