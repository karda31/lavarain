        function updateLobbyPhysics() {
            if (!isHost) return;
            syncLobbyEntitiesFromPlayers();
            const g = 0.45;
            const ents = lobbyPlayers.map(lp => lobbyEntities[lp.id]).filter(Boolean);
            ents.forEach(e => {
                let goLeft = false, goRight = false, doJump = false;
                if (e.id === myPlayerId) {
                    if (!chatOpen && !pauseMenuOpen) {
                        goLeft = ctrlLeft();
                        goRight = ctrlRight();
                        doJump = ctrlJump();
                    }
                } else {
                    const ri = remoteInputs[e.id] || {};
                    goLeft = !!ri.left; goRight = !!ri.right; doJump = !!ri.jump;
                }
                const spd = 3.6;
                if (goLeft) e.vx = -spd;
                else if (goRight) e.vx = spd;
                else e.vx *= 0.78;
                if (doJump && e.onGround) {
                    e.vy = -9.2;
                    e.onGround = false;
                }
                e.vy += g;
                e.x += e.vx;
                e.y += e.vy;
                e.animFrame = (e.animFrame || 0) + Math.abs(e.vx) * 0.12;
                if (e.pushAnim && e.pushAnim > 0) e.pushAnim--;
                if (e.x < 0) e.x = 0;
                if (e.x + e.w > canvas.width) e.x = canvas.width - e.w;
                e.onGround = false;
                LOBBY_PLATFORMS.forEach(pl => {
                    if (e.x + e.w > pl.x && e.x < pl.x + pl.w) {
                        if (e.y + e.h >= pl.y && e.y + e.h - e.vy <= pl.y + 14 && e.vy >= 0) {
                            e.y = pl.y - e.h;
                            if (pl.slime) {
                                e.vy = -12;
                                e.onGround = false;
                                e.slimeBounce = 8;
                            } else {
                                e.vy = 0;
                                e.onGround = true;
                            }
                        }
                    }
                });
                if (e.slimeBounce && e.slimeBounce > 0) e.slimeBounce--;
                if (e.y > canvas.height + 20) {
                    e.y = 380;
                    e.vy = 0;
                    e.x = 80 + Math.random() * 640;
                }
            });
            // Lobi ittirme: sadece yatay ayırma (çapraz uçurma yok)
            for (let i = 0; i < ents.length; i++) {
                for (let j = i + 1; j < ents.length; j++) {
                    const a = ents[i], b = ents[j];
                    if (!(a.x < b.x + b.w && a.x + a.w > b.x && a.y < b.y + b.h && a.y + a.h > b.y)) continue;
                    const overlapX = Math.min(a.x + a.w, b.x + b.w) - Math.max(a.x, b.x);
                    const overlapY = Math.min(a.y + a.h, b.y + b.h) - Math.max(a.y, b.y);
                    if (overlapX <= 0 || overlapY <= 0) continue;
                    const midA = a.x + a.w / 2;
                    const midB = b.x + b.w / 2;
                    // Dikey bindirme daha fazlaysa üst üste binme — hafif y ekseni düzelt
                    if (overlapY < overlapX && overlapY < 18) {
                        if (a.y + a.h / 2 < b.y + b.h / 2) {
                            a.y -= overlapY * 0.5;
                            b.y += overlapY * 0.5;
                            if (a.vy > 0) a.vy = 0;
                            if (b.vy < 0) b.vy *= 0.3;
                        } else {
                            b.y -= overlapY * 0.5;
                            a.y += overlapY * 0.5;
                            if (b.vy > 0) b.vy = 0;
                            if (a.vy < 0) a.vy *= 0.3;
                        }
                        continue;
                    }
                    // Yan çarpışma: sadece X ayır + yatay itme
                    const sep = Math.max(1.5, overlapX * 0.5);
                    if (midA < midB) { a.x -= sep; b.x += sep; }
                    else { a.x += sep; b.x -= sep; }
                    const dir = midA < midB ? -1 : 1; // a'nın itildiği yön
                    // Sabit, kontrollü yatay savrulma — vy'ye dokunma
                    const knock = 2.8;
                    a.vx = dir * knock;
                    b.vx = -dir * knock;
                    // Dikey hızı koru / bozma (çapraz uçuş engeli)
                    a.pushAnim = 10; a.pushDir = -dir;
                    b.pushAnim = 10; b.pushDir = dir;
                    if (a.x < 0) a.x = 0;
                    if (b.x < 0) b.x = 0;
                    if (a.x + a.w > canvas.width) a.x = canvas.width - a.w;
                    if (b.x + b.w > canvas.width) b.x = canvas.width - b.w;
                }
            }
            const now = Date.now();
            const lobbyHz = (typeof mobilePerf !== "undefined" && mobilePerf) ? 66 : 40;
            if (now - lastLobbyBroadcast > lobbyHz) {
                lastLobbyBroadcast = now;
                const payload = {
                    type: "lobby_state",
                    entities: Object.values(lobbyEntities).map(e => ({
                        id: e.id, x: e.x, y: e.y, vx: e.vx, vy: e.vy, onGround: e.onGround,
                        animFrame: e.animFrame || 0, name: e.name, color: e.color,
                        pushAnim: e.pushAnim || 0, pushDir: e.pushDir || 1
                    })),
                    players: lobbyPlayers,
                    names: onlinePlayerNames
                };
                netSend(payload);
            }
        }

