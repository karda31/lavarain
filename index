        // Mağaza / Sunucu kaydırma (mouse wheel)
        canvas.addEventListener("wheel", (e) => {
            if (gameState === "STORE") {
                e.preventDefault();
                storeScroll += e.deltaY > 0 ? 1 : -1;
                storeScroll = Math.max(0, Math.min(storeScroll, shopItems.length - STORE_VISIBLE));
