        function tryShoot(p) {
            if (!p || p.isDead || p.fireCooldown > 0) return;
            const wid = p.weaponId || "pistol";
            const w = WEAPON_TYPES[wid] || WEAPON_TYPES.pistol;
            if (w.ammo !== Infinity && (p.ammo == null || p.ammo <= 0)) {
                p.weaponId = "pistol";
                p.ammo = Infinity;
                return tryShoot(p);
            }
            const dir = p.facing >= 0 ? 1 : -1;
            const pellets = w.pellets || 1;
            const spread = w.pelletSpread || 0;
            for (let i = 0; i < pellets; i++) {
                const ang = (i - (pellets - 1) / 2) * spread;
                const spd = w.speed * (p.isHunter ? 1.15 : 1);
                const vx = Math.cos(ang) * spd * dir;
                const vy = Math.sin(ang) * spd * 0.35;
                bullets.push({
                    x: dir > 0 ? p.x + p.width : p.x - (w.bulletW || 12),
                    y: p.y + p.height * 0.35,
                    width: w.bulletW || 12,
                    height: w.bulletH || 5,
                    vx, vy: vy || 0,
                    ownerId: p.id,
                    damage: w.damage || 1,
                    knock: (w.knock || 6) * (p.isHunter ? 1.25 : 1),
                    color: w.color || "#ff00ff",
                    explosive: !!w.explosive
                });
            }
            p.fireCooldown = w.cooldown || 15;
            if (w.ammo !== Infinity) {
                p.ammo = (p.ammo || 0) - 1;
                if (p.ammo <= 0) {
                    p.weaponId = "pistol";
                    p.ammo = Infinity;
                }
            }
            // geri tepme (hafif)
            p.vx -= dir * 0.8;
        }

