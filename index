            } else if (gameState === "CREATE_SERVER") {
                if (e.code === "Backspace") {
                    if (createForm.focus === "name") createForm.name = createForm.name.slice(0, -1);
                    else if (createForm.focus === "password") createForm.password = createForm.password.slice(0, -1);
                    e.preventDefault();
                } else if (e.key && e.key.length === 1 && !e.ctrlKey && !e.metaKey) {
                    if (createForm.focus === "name" && createForm.name.length < 24) {
                        createForm.name += e.key;
                    } else if (createForm.focus === "password" && createForm.password.length < 20) {
                        createForm.password += e.key;
