            } else if (gameState === "JOIN_CODE") {
                if (e.code === "Backspace") {
                    if (joinForm.focus === "code") joinForm.code = joinForm.code.slice(0, -1);
                    else if (joinForm.focus === "password") joinForm.password = joinForm.password.slice(0, -1);
                    else if (joinForm.focus === "name") joinForm.name = joinForm.name.slice(0, -1);
                    e.preventDefault();
                } else if (e.key && e.key.length === 1 && !e.ctrlKey && !e.metaKey) {
                    if (joinForm.focus === "code" && joinForm.code.length < 8) joinForm.code += e.key.toUpperCase();
                    else if (joinForm.focus === "password" && joinForm.password.length < 20) joinForm.password += e.key;
                    else if (joinForm.focus === "name" && joinForm.name.length < 12) joinForm.name += e.key;
