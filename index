        function hostNotify(text) {
            // Sadece host görür (sistem chat, kırmızımsı)
            addChat("Host", text, "#ffaa00");
        }

        function findPlayerByArg(arg) {
            if (!arg) return null;
            const a = String(arg).trim().toLowerCase();
            // P2, p2, 2
            let m = a.match(/^p?(\d+)$/);
            if (m) {
                const id = parseInt(m[1], 10);
                if (onlinePlayerNames[id] || lobbyPlayers.some(p => p.id === id) || players.some(p => p.id === id)) {
                    return { id, name: onlinePlayerNames[id] || ("P" + id) };
                }
            }
            // isim ile
            for (const lp of lobbyPlayers) {
                if ((lp.name || "").toLowerCase() === a) return { id: lp.id, name: lp.name };
            }
            for (const [id, nm] of Object.entries(onlinePlayerNames)) {
                if (String(nm).toLowerCase() === a) return { id: Number(id), name: nm };
            }
            return null;
        }

        function kickPlayerById(pid, reason) {
            if (!isHost || pid === 1 || pid === myPlayerId) {
                hostNotify("Kendini veya host'u atamazsın.");
                return false;
            }
            const peerId = playerIdToPeer[pid];
            const name = onlinePlayerNames[pid] || ("P" + pid);
            if (peerId && connections[peerId]) {
                netSendTo(connections[peerId], { type: "kicked", reason: reason || "Host tarafından atıldın." });
                try { connections[peerId].close(); } catch (e) {}
            }
            if (peerId && peerIdToPlayer[peerId]) {
                onClientDisconnect(peerId, "kick");
            } else {
                lobbyPlayers = lobbyPlayers.filter(p => p.id !== pid);
                delete onlinePlayerNames[pid];
                delete lobbyEntities[pid];
                delete remoteInputs[pid];
                delete playerIdToPeer[pid];
                if (gameState === "PLAYING") {
                    const p = players.find(x => x.id === pid);
                    if (p && !p.isDead) {
                        p.isDead = true;
                        p.hp = 0;
                        const card = document.getElementById("p" + pid + "-card");
                        if (card) card.classList.add("dead");
                    }
                }
                netSend({ type: "lobby", players: lobbyPlayers, names: onlinePlayerNames });
                updateServerListPlayers();
                broadcastSystem(name + " (P" + pid + ") odadan atıldı.", "#ff6644");
            }
            return true;
        }

        function banPlayerById(pid) {
            if (!isHost || pid === 1 || pid === myPlayerId) {
                hostNotify("Kendini veya host'u banlayamazsın.");
                return false;
            }
            const name = onlinePlayerNames[pid] || ("P" + pid);
            bannedNames[String(name).toLowerCase()] = true;
            const peerId = playerIdToPeer[pid];
            if (peerId) bannedPeerIds[peerId] = true;
            kickPlayerById(pid, "Bu odadan banlandın.");
            hostNotify(name + " (P" + pid + ") banlandı. (Yeniden giremez)");
            return true;
        }

        function setHostPause(on) {
            if (!isHost) return;
            hostPaused = !!on;
            netSend({ type: "host_pause", paused: hostPaused });
            if (hostPaused) {
                broadcastSystem("Host oyunu duraklattı.", "#ffaa00");
            } else {
                broadcastSystem("Host oyunu devam ettirdi.", "#88ff88");
            }
        }

        function handleHostCommand(raw) {
            if (!isHost) return;
            const parts = raw.trim().split(/\s+/);
            const cmd = (parts[0] || "").toLowerCase();
            const arg = parts.slice(1).join(" ").trim();

            if (cmd === "/pause") {
                setHostPause(!hostPaused);
                hostNotify(hostPaused ? "Oyun duraklatıldı. (/pause ile devam)" : "Oyun devam ediyor.");
                return;
            }
            if (cmd === "/unpause" || cmd === "/resume") {
                setHostPause(false);
                hostNotify("Oyun devam ediyor.");
                return;
            }
            if (cmd === "/kick") {
                if (!arg) { hostNotify("Kullanım: /kick P2  veya  /kick isim"); return; }
                const t = findPlayerByArg(arg);
                if (!t) { hostNotify("Oyuncu bulunamadı: " + arg); return; }
                kickPlayerById(t.id, "Host tarafından atıldın.");
                return;
            }
            if (cmd === "/ban") {
                if (!arg) { hostNotify("Kullanım: /ban P2  veya  /ban isim"); return; }
                const t = findPlayerByArg(arg);
                if (!t) { hostNotify("Oyuncu bulunamadı: " + arg); return; }
                banPlayerById(t.id);
                return;
            }
            if (cmd === "/help" || cmd === "/komutlar") {
                hostNotify("Komutlar: /kick P2 | /ban isim | /pause | /unpause");
                return;
            }
            hostNotify("Bilinmeyen komut: " + cmd + "  (/help)");
        }

        function netSend(msg) {
            const data = JSON.stringify(msg);
            if (isHost) {
                Object.values(connections).forEach(c => {
                    if (c && c.open) try { c.send(data); } catch (e) {}
                });
            } else if (hostConn && hostConn.open) {
                try { hostConn.send(data); } catch (e) {}
            }
        }

        function netSendTo(conn, msg) {
            if (conn && conn.open) {
                try { conn.send(JSON.stringify(msg)); } catch (e) {}
            }
        }

        function removeServerFromList(code) {
            if (!code) return;
            const before = serverList.length;
            serverList = serverList.filter(s => String(s.id).toUpperCase() !== String(code).toUpperCase());
            if (serverList.length !== before) saveServers();
            removeServerFromDiscovery(code);
        }

        function serverNeedsPassword(srv) {
            if (!srv) return false;
            if (srv.hasPassword) return true;
            const p = srv.password;
            return !!(p && p.length > 0);
        }

        function passwordMatchesLocal(srv, input) {
            if (!srv) return false;
            // Uzak listeden gelen şifre gizlenmiş — host doğrular
            if (srv.password === "__SET__" || (srv.hasPassword && (!srv.password || srv.password === "__SET__"))) {
                return true; // istemci tarafında kabul; host reddederse join_fail
            }
            return srv.password === input;
        }

        function normalizeServerName(n) {
            return String(n || "").trim().toLowerCase();
        }

        function isServerNameTaken(name, exceptCode) {
            const key = normalizeServerName(name);
            if (!key) return false;
            return serverList.some(s =>
                s && s.active !== false && normalizeServerName(s.name) === key &&
                (!exceptCode || String(s.id).toUpperCase() !== String(exceptCode).toUpperCase())
            );
        }

        // Hayalet odaları temizle (kapalı / süresi dolmuş)
        const SERVER_STALE_MS = 3 * 60 * 1000; // 3 dk heartbeat yoksa hayalet oda düşer
        function isLiveServer(s) {
            if (!s) return false;
            if (s.active === false || s.online === false) return false;
            const pc = s.players;
            if (pc == null || pc === undefined || Number(pc) <= 0) return false;
            const last = s.updatedAt || s.createdAt || 0;
            if (!last || (Date.now() - last) > SERVER_STALE_MS) return false;
            return true;
        }
        function pruneStaleServers() {
            const before = serverList.length;
            serverList = serverList.filter(isLiveServer);
            if (serverList.length !== before) {
                try { localStorage.setItem("lavaRainServers", JSON.stringify(serverList)); } catch (e) {}
            }
        }

        function leaveOnlineRoom(reason) {
            pauseMenuOpen = false;
            const name = onlinePlayerNames[myPlayerId] || ("P" + myPlayerId);
            if (isOnline && isHost) {
                broadcastSystem("Host " + name + " sunucuyu kapattı. Herkes odadan ayrıldı.", "#ff4455");
